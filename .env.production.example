# Copia a .env.production en el VPS y rellena valores reales.
# Nunca subas .env.production al repositorio.

# --- Postgres (solo stack Fleetline) ---
POSTGRES_USER=fsg
POSTGRES_PASSWORD=cambia_esta_clave_larga
POSTGRES_DB=fsg_crm
# Publicación en el host (solo localhost). Déjalo así salvo que necesites otro puerto.
FLEETLINE_PG_HOST_PORT=127.0.0.1:55432

# --- Puertos en el HOST (elige libres: no deben coincidir con el otro Docker) ---
FLEETLINE_API_HOST_PORT=4010
FLEETLINE_WEB_HOST_PORT=3010

# --- Auth ---
JWT_SECRET=genera_un_secreto_largo_aleatorio

# --- URLs públicas (dominio o IP del VPS + puertos publicados) ---
# Si usas Nginx/Caddy delante, apunta al dominio (https://crm.tudominio.com).
NEXT_PUBLIC_API_URL=http://TU_IP_O_DOMINIO:4010
NEXT_PUBLIC_WS_URL=http://TU_IP_O_DOMINIO:4010
CORS_ORIGINS=http://TU_IP_O_DOMINIO:3010
