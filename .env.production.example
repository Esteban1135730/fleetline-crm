# Copia a .env.production en el VPS y rellena valores reales.
# Nunca subas .env.production al repositorio.

# --- Postgres (solo stack Fleetline) ---
POSTGRES_USER=fsg
POSTGRES_PASSWORD=cambia_esta_clave_larga
POSTGRES_DB=fsg_crm
# Publicación en el host (solo localhost). Déjalo así salvo que necesites otro puerto.
FLEETLINE_PG_HOST_PORT=127.0.0.1:55432

# --- Puertos en el HOST (elige libres: no deben coincidir con el otro Docker) ---
FLEETLINE_API_HOST_PORT=4010
FLEETLINE_WEB_HOST_PORT=3010

# --- Auth ---
# openssl rand -hex 32  (≥32 chars; nunca reutilizar el de ejemplo)
JWT_SECRET=genera_un_secreto_largo_aleatorio_minimo_32
JWT_EXPIRES_IN=8h

# Cifrado de campos (AES-256-GCM) — openssl rand -hex 32
FIELD_ENCRYPTION_KEY=genera_otra_clave_distinta_minimo_32c

# MFA Tesorería (6 dígitos; prohibido 000000 en prod)
TREASURY_MFA_STATIC_OTP=cambiar_otp_6_digitos
TREASURY_MFA_THRESHOLD_COP=5000000

# Turnstile (opcional)
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cookies Secure + redirect HTTPS detrás de proxy
COOKIE_SECURE=true
# FORCE_HTTPS=true
# TRUST_PROXY=true
# TRUST_PROXY_HOPS=1

# Rate-limit login: tope flood 120/15min; bloqueo real = 15 fallos/15min (no cuenta logins OK)
# LOGIN_THROTTLE_LIMIT=120
# LOGIN_THROTTLE_TTL_MS=900000
# LOGIN_FAIL_LIMIT=15
# LOGIN_FAIL_WINDOW_MS=900000

# Prisma
PRISMA_SLOW_QUERY_MS=500

# --- URLs públicas (dominio o IP del VPS + puertos publicados) ---
# Si usas Nginx/Caddy delante, apunta al dominio (https://crm.tudominio.com).
NEXT_PUBLIC_API_URL=http://TU_IP_O_DOMINIO:4010
NEXT_PUBLIC_WS_URL=http://TU_IP_O_DOMINIO:4010
CORS_ORIGINS=http://TU_IP_O_DOMINIO:3010

# DATABASE_URL la arma Compose; si usas Postgres externo con TLS:
# DATABASE_URL=postgresql://user:pass@host:5432/fsg_crm?schema=public&sslmode=require

# --- Web Push (VAPID) — generar: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@inretrans.co

# --- QA Trace (servidor de pruebas) — panel solo esteban* ---
QA_TRACE_ENABLED=true
QA_TRACE_ALLOWLIST=esteban@inretrans.com,esteban
NEXT_PUBLIC_QA_TRACE=1
NEXT_PUBLIC_QA_TRACE_ALLOWLIST=esteban@inretrans.com,esteban

# --- Mapas / ruteo (opcional) ---
# Por defecto: OSRM público + Nominatim OSM (sin API key).
# OSRM_URL=https://router.project-osrm.org
# NOMINATIM_USER_AGENT=InretransOS/1.0 (ops@tudominio.com)

# --- RUNT / trámites ---
# RUNT_API_URL=
# RUNT_API_TOKEN=
# RUNT_MOCK_EXPIRED_PLATES=BUS-002
# RUNT_NIGHTLY_SYNC=false
# RUNT_NIGHTLY_BATCH=50
# RUNT_NIGHTLY_DELAY_MS=200
