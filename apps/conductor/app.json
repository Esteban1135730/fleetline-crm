{
  "expo": {
    "name": "NEXA Conductor",
    "slug": "fsg-conductor",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fsg-conductor",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050B14"
    },
    "extra": {
      "apiUrl": "https://crm-api.inredesoft.com"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.fsg.conductor",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#050B14"
      },
      "package": "co.fsg.conductor"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a INRETRANS OS enviar tu ubicación durante viajes en curso."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite adjuntar fotos de incidentes en ruta."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#10B981",
          "defaultChannel": "default"
        }
      ]
    ]
  }
}
