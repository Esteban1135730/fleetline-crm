# Base de datos (Docker por defecto en puerto 55432)
DATABASE_URL=postgresql://fsg:fsg_secret@localhost:55432/fsg_crm?schema=public
# Redis publicado en 56379 para no chocar con otro Redis en :6379
REDIS_URL=redis://localhost:56379

# Auth — cámbialo en producción
JWT_SECRET=dev-secret-fsg-mega-os-2026

# API
API_PORT=4000
# Orígenes permitidos (web + Expo). Separados por coma.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8081,http://localhost:19006

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# App Conductor (Expo) — en dispositivo físico usa la IP LAN del PC
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# Emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Web Push (VAPID) — generar con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@inretrans.co
