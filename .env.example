# Base de datos (Docker por defecto en puerto 55432)
# Producción con TLS: añade ?sslmode=require
DATABASE_URL=postgresql://fsg:fsg_secret@localhost:55432/fsg_crm?schema=public
# Redis publicado en 56379 para no chocar con otro Redis en :6379
REDIS_URL=redis://localhost:56379

# Auth — genera uno propio: openssl rand -hex 32
# NUNCA uses este valor en producción
JWT_SECRET=cambia_este_secreto_local_min_32_chars_xx
JWT_EXPIRES_IN=8h

# Cifrado de campos sensibles (AES-256-GCM). Si se omite, se deriva de JWT_SECRET.
# FIELD_ENCRYPTION_KEY=

# API
API_PORT=4000
# Orígenes permitidos (web + Expo). Separados por coma.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8081,http://localhost:19006

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Apps móviles (Expo) — por defecto apuntan al VPS :4010
# EXPO_PUBLIC_API_URL=http://76.13.101.203:4010
# Desarrollo local (API en el PC):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Cloudflare Turnstile (opcional — si se define, login exige token)
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# MFA Tesorería (obligatorio en prod, 6 dígitos ≠ 000000)
# TREASURY_MFA_STATIC_OTP=483921
# TREASURY_MFA_THRESHOLD_COP=5000000

# Prisma slow queries
# PRISMA_SLOW_QUERY_MS=500

# Cookies Secure + redirect HTTPS detrás de proxy
# COOKIE_SECURE=true
# FORCE_HTTPS=true
# TRUST_PROXY=true

# Rate-limit login: tope flood 120/15min; bloqueo real = 15 fallos/15min
# LOGIN_THROTTLE_LIMIT=120
# LOGIN_THROTTLE_TTL_MS=900000
# LOGIN_FAIL_LIMIT=15
# LOGIN_FAIL_WINDOW_MS=900000

# Web Push (VAPID) — generar con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@inretrans.co

# Mapas / ruteo (LOG-01) — sin API key de Google/Mapbox
# Stack por defecto: Leaflet + CARTO/OSM + OSRM público + Nominatim
# OSRM_URL=https://router.project-osrm.org
# NOMINATIM_USER_AGENT=InretransOS/1.0 (ops@tudominio.com)
# Telemetría flota opcional (NOC / Wialon):
# WIALON_TOKEN=
# GURTAM_TOKEN=

# RUNT / trámites (TRA-01 / TRA-03)
# Sin URL+token → mock determinista (placas *002 / BLOQ vencidas)
# RUNT_API_URL=
# RUNT_API_TOKEN=
# RUNT_MOCK_EXPIRED_PLATES=BUS-002
# Sync automática nocturna (default off hasta sandbox/prod)
# RUNT_NIGHTLY_SYNC=false
# RUNT_NIGHTLY_BATCH=50
# RUNT_NIGHTLY_DELAY_MS=200
