# Evita conflictos de @types/react duplicados en monorepo + Docker
public-hoist-pattern[]=*@types/react*
public-hoist-pattern[]=*@types/react-dom*
# Multer debe resolverse con require() desde dist de Nest
public-hoist-pattern[]=*multer*
# Expo / Metro (pnpm) — resolución de módulos nativos
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*expo-*
public-hoist-pattern[]=*@expo/*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*react-native-*
