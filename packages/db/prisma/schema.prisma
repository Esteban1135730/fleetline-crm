enum BankReconciliationStatus {
  OPEN
  PARTIAL
  CLOSED
}

/// Extracto bancario cargado (.CSV/Excel) — conciliación diaria
model BankStatement {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankName       String?
  accountMask    String?
  periodDate     DateTime
  fileName       String?
  rawRows        Json?
  uploadedById   String?
  createdAt      DateTime @default(now())
  lines          BankStatementLine[]
  reconciliation BankReconciliation?

  @@index([organizationId, periodDate])
}

model BankStatementLine {
  id            String        @id @default(cuid())
  statementId   String
  statement     BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  externalRef   String?
  description   String
  amount        Decimal       @db.Decimal(14, 2)
  bookedAt      DateTime?
  matched       Boolean       @default(false)
  invoiceId     String?
  matchScore    Float?
  createdAt     DateTime      @default(now())

  @@index([statementId, matched])
  @@index([invoiceId])
}

model BankReconciliation {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statementId    String                   @unique
  statement      BankStatement            @relation(fields: [statementId], references: [id], onDelete: Cascade)
