  alertRed       Boolean           @default(true)
  caseRef        String?
  notes          String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, dueAt])
  @@index([kind, dueAt])
}

/// Memorando de descargos disciplinarios + evidencias GPS
model DisciplinaryMemo {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  subjectName    String
  document       String?
  plate          String?
  charge         String
  gpsEvidence    Json?
  attachments    Json?
  status         String   @default("ISSUED")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, createdAt])
  @@index([plate])
}

/// Pipeline onboarding afiliado / flota externa (Módulo 13)
model AffiliateOnboarding {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  /// RECEIVED | VALIDATING_DOCS | CONTRACT_SIGN | ACTIVE_FLEET | REJECTED
  stage            String       @default("RECEIVED")
  ownerName        String
  ownerDocument    String
  ownerEmail       String?
  ownerPhone       String?
  plate            String?
  vehicleId        String?
  contractPdfRef   String?
  contractSignedAt DateTime?
  assignedToId     String?
  notes            String?
  meta             Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  portalLinks      AffiliatePortalLink[]

  @@unique([organizationId, code])
  @@index([organizationId, stage, createdAt])
  @@index([ownerDocument])
  @@index([plate])
}

/// Link auto-servicio propietario (OCR + docs)
model AffiliatePortalLink {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  onboardingId     String?
  onboarding       AffiliateOnboarding? @relation(fields: [onboardingId], references: [id], onDelete: SetNull)
  token            String       @unique
  ownerEmail       String?
  ownerName        String?
  expiresAt        DateTime
  usedAt           DateTime?
  createdById      String
  meta             Json?
  createdAt        DateTime     @default(now())

  @@index([organizationId, expiresAt])
  @@index([onboardingId])
}

/// Background check SIMIT + RUNT por cédula conductor
model DriverBackgroundCheck {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document         String
  driverId         String?
  driverName       String?
  /// GREEN | AMBER | RED
  riskLight        String
  simitFinesCount  Int          @default(0)
  simitTotalCop    Float        @default(0)
  runtLicenseValid Boolean      @default(false)
  runtLicenseExpiresAt DateTime?
  diagnosis        String
  rawPayload       Json?
  checkedById      String?
  createdAt        DateTime     @default(now())

  @@index([organizationId, document, createdAt])
  @@index([riskLight, createdAt])
  @@index([driverId])
}

// =============================================================================
// 2. FLOTA — VEHÍCULOS, CONDUCTORES Y COMPLIANCE (SOAT / RUNT / LICENCIAS)
//     Kill-Switch: complianceBlocked / nightRestricted bloquean despacho
// =============================================================================

model Vehicle {
  id                   String        @id @default(cuid())
  plate                String
  brand                String
  model                String
  year                 Int
  vin                  String?
  capacity             Int           @default(20)
  status               VehicleStatus @default(AVAILABLE)
  lat                  Float         @default(4.711)
  lng                  Float         @default(-74.0721)
  /// Rendimiento esperado km/galón (Smart Audit combustible)
  expectedKmPerGallon Float?
  odometerKm           Int           @default(0)
  maintenanceEveryKm   Int           @default(10000)
  /// Hard-Stop operativo (SOAT/FUEC/licencias vencidas, Kafka tramites.vehiculo.suspendido)
  complianceBlocked    Boolean       @default(false)
  complianceReason     String?
  /// Kill-Switch nocturno / restricción horaria
  nightRestricted      Boolean       @default(false)
  soatActivo           Boolean       @default(false)
  tecnoActiva          Boolean       @default(false)
  organizationId       String
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  trips            Trip[]
  planillas        Planilla[]
  workOrders       WorkOrder[]
  fleetStops       FleetStop[]
  fuecDocuments    FuecDocument[]
  complianceDocs   ComplianceDocument[]
  parkingLogs      ParkingLog[]
  yardEvents       YardEvent[]
  yardAccessLogs   YardAccessLog[]
  yardInspections  YardInspection[]
  gpsSnapshots     GpsSnapshot[]
  archiveDocuments ArchiveDocument[]
  hqseIncidents    HqseIncident[]
  pqrsTickets      Ticket[]
  schoolRoutes     SchoolRoute[]

  @@unique([organizationId, plate])
  @@index([organizationId, status])
  @@index([organizationId, complianceBlocked])
  @@index([organizationId, soatActivo, tecnoActiva])
  @@index([status, complianceBlocked])
}

/// Parada de flota sincronizada — aprobación Director Operativo (Módulo 9)
model FleetStop {
  id               String          @id @default(cuid())
  code             String
  kind             FleetStopKind   @default(PREVENTIVE_MAINTENANCE)
  status           FleetStopStatus @default(PENDING)
  reason           String
  windowStart      DateTime
  windowEnd        DateTime
  vehicleId        String
  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workOrderId      String?
  requestedById    String?
  approvedById     String?
  approvedBy       User?           @relation("FleetStopApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  /// Bloquea programación Gantt en la ventana
  blocksGantt      Boolean         @default(true)
  meta             Json?
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status, windowStart])
  @@index([vehicleId, status, windowStart])
  @@index([status, windowEnd])
}

model Driver {
  id               String       @id @default(cuid())
  name             String
  document         String
  phone            String?
  licenseNumber    String?
  licenseExpiresAt DateTime?
  licenseCategory  String?
  active           Boolean      @default(true)
  fatigueScore     Int          @default(0)
  /// Driver Score seguridad vial (100 = nominal; baja con excesos/frenadas)
  safetyScore      Int          @default(100)
  /// Bloqueo por licencia vencida / fatiga / RRHH
  dispatchBlocked  Boolean      @default(false)
  blockReason      String?
  userId           String?      @unique
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  trips          Trip[]
  planillas      Planilla[]
  complianceDocs ComplianceDocument[]
  preops         Preoperational[]
  shifts         DriverShift[]
  payrollLines   PayrollLine[]
  employee       Employee?
  parkingLogs    ParkingLog[]
  yardAccessLogs YardAccessLog[]
  archiveDocuments ArchiveDocument[]
  hqseIncidents    HqseIncident[]
  hqseTrainings    HqseTrainingRecord[]
  pqrsTickets      Ticket[]
  schoolRoutes     SchoolRoute[]
  novelties        DriverNovelty[]

  @@unique([organizationId, document])
  @@index([organizationId, active])
  @@index([organizationId, dispatchBlocked])
  @@index([licenseExpiresAt])
  @@index([fatigueScore])
}

/// Documentos de compliance (vehículo o conductor) — SOAT, RUNT, licencias, etc.
model ComplianceDocument {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type             ComplianceDocType
  status           DocStatus         @default(PENDING)
  reference        String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  /// Hash OCR / archivo sellado
  contentHash      String?
  fileRef          String?
  /// Resultado validación RUNT / Fasecolda / Document AI
  runtVerified     Boolean           @default(false)
  runtPayload      Json?
  ocrPayload       Json?
  vehicleId        String?
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId         String?
  driver           Driver?           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId, type, status])
  @@index([organizationId, expiresAt])
  @@index([vehicleId, type, status])
  @@index([driverId, type, status])
  @@index([status, expiresAt])
  @@index([contentHash])
}

// =============================================================================
// 3. LOGÍSTICA — RUTAS, VIAJES, PLANILLAS / FUEC, PREOPERACIONAL, GPS
// =============================================================================

model Route {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  origin         String
  destination    String
  polyline       String?
  distanceKm     Float?
  etaMinutes     Int?
  active         Boolean      @default(true)
  meta           Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  trips     Trip[]
  planillas Planilla[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model Trip {
  id             String       @id @default(cuid())
  code           String
  origin         String
  destination    String
  departAt       DateTime
  /// Fin programado del servicio
  arriveAt       DateTime?
  /// Inicio / fin reales (reloj servidor)
  startedAt      DateTime?
  completedAt    DateTime?
  status         TripStatus   @default(PENDING)
  fareAmount     Decimal      @db.Decimal(14, 2)
  distanceKm     Float?
  incidentNote   String?
  /// Cliente / funcionario beneficiario del servicio
  officerName    String?
  officerDocument String?
  suggestedPolyline String?
  originLat      Float?
  originLng      Float?
  destLat        Float?
  destLng        Float?
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contractId     String?
  contract       TransportContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId       String?
  driver         Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  routeId        String?
  route          Route?       @relation(fields: [routeId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Publicación App conductor (itinerario / ack lectura)
  meta           Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  planilla       Planilla?
  preoperational Preoperational?
  routeExpenses  RouteExpense[]
  invoices       Invoice[]
  boardingPasses BoardingPass[]
  b2bRequests    B2bServiceRequest[]
  auditLogs      TripAuditLog[]
  trackPoints    TripTrackPoint[]
  overtimeLines  TripOvertimeLine[]
  deviationRequests TripDeviationRequest[]
  chatMessages   TripChatMessage[]
  fieldIncidents TripFieldIncident[]
  /// Facturación anticipada — bloquea Despacho hasta PAID
  advancePaymentRequired Boolean @default(false)
  advancePaymentLink     CommercialAdvancePaymentLink?

  @@unique([code])
  @@index([organizationId, status])
  @@index([organizationId, departAt])
  @@index([vehicleId, status])
  @@index([driverId, status])
  @@index([customerId])
  @@index([status, departAt])
  @@index([advancePaymentRequired, status])
}

/// Auditoría inmutable vinculada al servicio
model TripAuditLog {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tripId         String
  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  action         TripAuditAction
  message        String
  meta           Json?
  actorUserId    String?
  serverTime     DateTime        @default(now())
  createdAt      DateTime        @default(now())

  @@index([tripId, createdAt])
  @@index([organizationId, createdAt])
}

/// Histórico GPS por servicio (App conductor → uplink)
model TripTrackPoint {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicleId  String?
  lat        Float
  lng        Float
  speedKph   Float?
  heading    Float?
  recordedAt DateTime @default(now())

  @@index([tripId, recordedAt])
  @@index([vehicleId, recordedAt])
}

/// Solicitud de inicio/fin fuera de tolerancia (geofence / horario) — aprobación supervisor
model TripDeviationRequest {
  id               String              @id @default(cuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tripId           String
  trip             Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  action           TripDeviationAction
  status           TripDeviationStatus @default(PENDING)
  /// Estado del viaje antes de la solicitud (para restaurar si se rechaza)
  previousStatus   TripStatus
  reasonCodes      String[]
  reasonDetail     String
  lat              Float
  lng              Float
  distanceM        Float?
  serverTime       DateTime            @default(now())
  scheduledAt      DateTime?
  requestedById    String?
  resolvedById     String?
  resolvedAt       DateTime?
  resolveNote      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([tripId, status])
}

/// Chat in-app por viaje (conductor ↔ supervisor)
model TripChatMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tripId         String
  trip           Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  authorUserId   String
  authorName     String
  authorRole     String
  body           String
  serverTime     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([tripId, createdAt])
  @@index([organizationId, createdAt])
}

/// Chat general de soporte técnico (app multi-rol)
model SupportChatMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorUserId   String
  authorName     String
  authorRole     String
  body           String
  serverTime     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

/// Incidente / retraso de campo — NO bloquea el viaje ni el GPS
model TripFieldIncident {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tripId         String
  trip           Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category       TripIncidentCategory
  notes          String?
  photoUrl       String?
  lat            Float?
  lng            Float?
  reportedById   String?
  serverTime     DateTime             @default(now())
  createdAt      DateTime             @default(now())

  @@index([tripId, createdAt])
  @@index([organizationId, createdAt])
}

/// Novedades de disponibilidad / calendario conductor
model DriverNovelty {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  driverId       String
  driver         Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  kind           DriverNoveltyKind
  dateFrom       DateTime
  dateTo         DateTime
  notes          String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, driverId, dateFrom])
  @@index([driverId, dateFrom, dateTo])
  @@index([kind, dateFrom])
}

/// Parámetros liquidación horas extras (Excel Proyecto CRM)
model PayrollLaborConfig {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  baseSalary           Decimal      @db.Decimal(14, 2) @default(1423500)
  monthlyHoursDivisor  Float        @default(230)
  weeklyOrdinaryHours  Float        @default(42)
  rnFactor             Float        @default(0.35)
  hedFactor            Float        @default(1.25)
  henFactor            Float        @default(1.75)
  rodFestFactor        Float        @default(1.75)
  hedfFactor           Float        @default(2.0)
  henfFactor           Float        @default(2.5)
  rnfFactor            Float        @default(1.1)
  updatedAt            DateTime     @updatedAt
  createdAt            DateTime     @default(now())
}

/// Pre-nómina de extras por servicio cerrado (fuente del reporte mensual /nomina)
model TripOvertimeLine {
  id             String   @id @default(cuid())
  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driverId       String
  workDate       DateTime
  ordinaryHours  Float    @default(0)
  rnHours        Float    @default(0)
  hedHours       Float    @default(0)
  henHours       Float    @default(0)
  rodFestHours   Float    @default(0)
  hedfHours      Float    @default(0)
  henfHours      Float    @default(0)
  rnfHours       Float    @default(0)
