enum RouteExpenseKind {
  PEAJE
  TANQUEO
  COMBUSTIBLE
  OTRO
}

enum RouteExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  POSTED
}

/// Smart Wallet / gastos de ruta — peajes, tanqueos (OCR + auditoría contable)
model RouteExpense {
  id             String             @id @default(cuid())
  organizationId String?
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tripId         String?
  trip           Trip?              @relation(fields: [tripId], references: [id], onDelete: SetNull)
  plate          String?
  vehicleId      String?
  driverId       String?
  driverName     String?
  kind           String // PEAJE | TANQUEO | COMBUSTIBLE | OTRO
  amount         Decimal            @db.Decimal(14, 2)
  gallons        Float?
  station        String?
  ocrPayload     Json?
  fileRef        String?
  photoRef       String?
  aiExtracted    Json?
  status         RouteExpenseStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  journalEntryId String?
  rejectReason   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt

  @@index([tripId, kind])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, plate])
  @@index([vehicleId])
  @@index([createdAt])
}

// =============================================================================
// 4. TALLER — OT, REPUESTOS, DESPACHO QR + EVIDENCIA CV
// =============================================================================

model WorkOrder {
  id               String          @id @default(cuid())
  code             String
  description      String
  status           WorkOrderStatus @default(OPEN)
  odometerAtOpen   Int?
  /// Bahía / floor plan (ej. BAY-A1)
  bayCode          String?
  /// ROUTINE | PREVENTIVE | CRITICAL
  severity         String          @default("ROUTINE")
  /// PENDING | PASSED | FAILED
  qcStatus         String          @default("PENDING")
  qcApprovedAt     DateTime?
  qcApprovedById   String?
  /// Alerta preventiva: km restantes al intervalo
  predictiveKmLeft Int?
  vehicleId        String
  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignedToId     String?
  assignedTo       User?           @relation("AssignedMechanic", fields: [assignedToId], references: [id], onDelete: SetNull)
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  openedAt         DateTime        @default(now())
  closedAt         DateTime?
  meta             Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  requiredParts WorkOrderPart[]
  dispatches    PartDispatch[]
  timeEntries   MechanicTimeEntry[]
  findings      MechanicFinding[]
  prekits       PrekitReservation[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([vehicleId, status])
  @@index([assignedToId, status])
  @@index([status, openedAt])
  @@index([bayCode])
  @@index([qcStatus])
}

model InventoryItem {
  id             String              @id @default(cuid())
  sku            String
  serial         String?
  name           String
  qrCode         String              @unique
  quantity       Int                 @default(0)
  minStock       Int                 @default(1)
  unitCost       Decimal             @db.Decimal(14, 2) @default(0)
  status         InventoryItemStatus @default(AVAILABLE)
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  workOrderParts WorkOrderPart[]
  dispatches     PartDispatch[]
  poLines        PurchaseOrderLine[]
  requisitions   PurchaseRequisition[]
  prekits        PrekitReservation[]

  @@unique([organizationId, sku])
  @@unique([organizationId, serial])
  @@index([organizationId, status])
  @@index([organizationId, quantity])
  @@index([supplierId])
}

model WorkOrderPart {
  id              String        @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Int           @default(1)

  @@unique([workOrderId, inventoryItemId])
  @@index([inventoryItemId])
}

model PartDispatch {
  id                 String        @id @default(cuid())
  workOrderId        String
  workOrder          WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItemId    String
  inventoryItem      InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  dispatchedById     String
  dispatchedBy       User          @relation("PartDispatcher", fields: [dispatchedById], references: [id], onDelete: Restrict)
  mechanicQrScanned  String?
  partQrScanned      String?
  /// Evidencia CV antifraude
  photoOldRef        String?
  photoNewRef        String?
  cvValidationOk     Boolean?
  cvPayload          Json?
  /// Costo imputado al centro de costo de la placa
  costCenterPlate    String?
  costAmount         Decimal?      @db.Decimal(14, 2)
  mechanicUserId     String?
  dispatchedAt       DateTime      @default(now())

  @@index([workOrderId, dispatchedAt])
  @@index([inventoryItemId])
  @@index([dispatchedById, dispatchedAt])
  @@index([costCenterPlate])
}

/// Time tracking FSG Tech App (mecánico)
model MechanicTimeEntry {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  mechanicId     String
  taskLabel      String    @default("TAREA")
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  durationSec    Int?
  active         Boolean   @default(true)
  meta           Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, mechanicId, active])
  @@index([workOrderId, startedAt])
}

/// Hallazgo foto/voz del mecánico → aprobación Coordinador
model MechanicFinding {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  mechanicId     String
  photoRef       String?
  voiceRef       String?
  /// Transcripción IA voz→texto
  transcript     String?
  notes          String?
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([workOrderId])
  @@index([mechanicId])
}

/// Pre-kitting — reserva de insumos 500 km antes del preventivo
model PrekitReservation {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId     String?
  workOrder       WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  vehicleId       String
  plate           String
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Int      @default(1)
  status          String   @default("RESERVED") // RESERVED | CONSUMED | RELEASED
  predictiveKmLeft Int?
  logisticsWindow Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, status])
  @@index([vehicleId, status])
  @@index([workOrderId])
}

// =============================================================================
// 5. COMPRAS — OC, REMISIÓN, FACTURA PROVEEDOR, 3-WAY MATCHING
// =============================================================================

model Supplier {
  id             String       @id @default(cuid())
  name           String
  nit            String
  email          String?
  phone          String?
  active         Boolean      @default(true)
  /// Bloqueo AML / listas restrictivas (Módulo 15)
  sarlaftBlocked Boolean      @default(false)
  sarlaftRiskScore Int        @default(0)
  /// SKUs / categorías que ofrece (smart bidding)
  productTags    String[]
  /// Calificación Vendor Hub (1–5)
  rating         Float        @default(4)
  /// Ahorro acumulado vs precio de lista (COP)
  totalSavings   Decimal      @db.Decimal(14, 2) @default(0)
  /// Cuenta bancaria dispersión (cambio dispara Hard-Block)
  bankAccountNumber String?
  bankName          String?
  paymentHardBlocked Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchaseOrders PurchaseOrder[]
  purchaseBids   PurchaseBid[]
  inventoryItems InventoryItem[]
  invoices       Invoice[]
  archiveDocuments ArchiveDocument[]
  bankAccountChanges SupplierBankAccountChange[]

  @@unique([organizationId, nit])
  @@index([organizationId, active])
  @@index([organizationId, sarlaftBlocked])
  @@index([organizationId, rating])
  @@index([organizationId, paymentHardBlocked])
}

/// Requisición Taller / stock crítico → Smart Bidding
model PurchaseRequisition {
  id               String             @id @default(cuid())
  code             String
  title            String
  urgency          RequisitionUrgency @default(LOW_STOCK)
  status           RequisitionStatus  @default(OPEN)
  quantity         Int                @default(1)
  inventoryItemId  String?
  inventoryItem    InventoryItem?     @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  sku              String?
  notes            String?
  selectedBidId    String?
  purchaseOrderId  String?
  meta             Json?
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  bids PurchaseBid[]

  @@unique([organizationId, code])
  @@index([organizationId, urgency, status])
  @@index([organizationId, status, createdAt])
  @@index([inventoryItemId])
}

model PurchaseBid {
  id               String              @id @default(cuid())
  requisitionId    String
  requisition      PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  unitPrice        Decimal             @db.Decimal(14, 2)
  leadDays         Int                 @default(3)
  selected         Boolean             @default(false)
  /// Link seguro para cotización del proveedor
  secureToken      String              @unique
  expiresAt        DateTime
  respondedAt      DateTime?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([requisitionId, selected])
  @@index([supplierId])
  @@index([secureToken])
}

model PurchaseOrder {
  id              String         @id @default(cuid())
  code            String
  description     String?
  status          PurchaseStatus @default(DRAFT)
  totalEstimated  Decimal        @db.Decimal(14, 2) @default(0)
  currency        String         @default("COP")
  matchStatus     ThreeWayMatchStatus @default(PENDING)
  matchNotes      String?
  /// Meta: PDF OC, escalamiento CFO, bid, seguro/SOAT
  meta            Json?
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  approvedById    String?
  approvedBy      User?          @relation("PurchaseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lines          PurchaseOrderLine[]
  goodsReceipts  GoodsReceipt[]
  supplierInvoices Invoice[]
  matchRecords   ThreeWayMatch[]
  archiveDocuments ArchiveDocument[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, matchStatus])
  @@index([supplierId, status])
  @@index([status, createdAt])
}

model PurchaseOrderLine {
  id              String         @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  description     String
  quantity        Int
  unitCost        Decimal        @db.Decimal(14, 2)
  lineTotal       Decimal        @db.Decimal(14, 2)

  @@index([purchaseOrderId])
  @@index([inventoryItemId])
}

/// Remisión de entrada (almacén) — pata 2 del 3-Way Matching
model GoodsReceipt {
  id              String        @id @default(cuid())
  code            String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedById    String
  receivedBy      User          @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt      DateTime      @default(now())
  quantityTotal   Int
  notes           String?
  payload         Json?

  matchRecords ThreeWayMatch[]

  @@unique([code])
  @@index([purchaseOrderId, receivedAt])
  @@index([receivedById])
}

/// Resultado del cruce OC + Remisión + Factura proveedor
model ThreeWayMatch {
  id               String              @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  goodsReceiptId   String?
  goodsReceipt     GoodsReceipt?       @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  invoiceId        String?
  invoice          Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  status           ThreeWayMatchStatus @default(PENDING)
  priceDelta       Decimal             @db.Decimal(14, 2) @default(0)
  qtyDelta         Int                 @default(0)
  details          Json?
  evaluatedAt      DateTime            @default(now())

  @@index([purchaseOrderId, status])
  @@index([status, evaluatedAt])
  @@index([invoiceId])
}

// =============================================================================
// 6. COMERCIAL — CLIENTES, COTIZACIONES, CONTRATOS
// =============================================================================

model Customer {
  id             String          @id @default(cuid())
  name           String
  nit            String
  email          String?
  phone          String?
  segment        CustomerSegment @default(B2B)
  sarlaftBlocked Boolean         @default(false)
  sarlaftRiskScore Int           @default(0)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  quotes        Quote[]
  trips         Trip[]
  invoices      Invoice[]
  sarlaftChecks SarlaftCheck[]
  contracts     TransportContract[]
  familyLinks   FamilyProfile[]
  pqrsTickets   Ticket[]
  passengers    PassengerProfile[]
  b2bRequests   B2bServiceRequest[]
  commercialDeals CommercialDeal[]
  advancePayments CommercialAdvancePaymentLink[]
  callLogs      CommercialCallLog[]
  commercialTasks CommercialTask[]
  timelineEvents CommercialTimelineEvent[]

  @@unique([organizationId, nit])
  @@index([organizationId, segment])
  @@index([organizationId, sarlaftBlocked])
  @@index([name])
}

model Quote {
  id         String      @id @default(cuid())
  code       String
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Decimal     @db.Decimal(14, 2)
  currency   String      @default("COP")
  status     QuoteStatus @default(DRAFT)
  notes      String?
  calcJson   Json?
  secopRef   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([code])
  @@index([customerId, status])
  @@index([status, createdAt])
}

model TransportContract {
  id                 String            @id @default(cuid())
  code               String
  name               String
  channel            CommercialChannel @default(PRIVATE)
  routeLabel         String
  monthlyValue       Decimal           @db.Decimal(14, 2)
  /// Presupuesto total contratado (COP)
  budgetCap          Decimal?          @db.Decimal(14, 2)
  budgetConsumed     Decimal           @db.Decimal(14, 2) @default(0)
  /// Cupo de viajes / vehículos
  tripQuota          Int?
  tripsUsed          Int               @default(0)
  vehicleQuota       Int?
  vehiclesAllocated  Int               @default(0)
  rateType           ContractRateType  @default(FIXED)
  fixedFare          Decimal?          @db.Decimal(14, 2)
  ratePerKm          Decimal?          @db.Decimal(14, 2)
  secopProcessId     String?
  startsAt           DateTime
  endsAt             DateTime?
  status             ContractStatus    @default(DRAFT)
  /// Firma electrónica (DocuSign / AdobeSign)
  signatureProvider  String?
  signedAt           DateTime?
  costCenterId       String?
  costCenter         CostCenter?       @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  npsScore           Float?
  portfolioCompliancePct Float?
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  trips Trip[]
  b2bRequests B2bServiceRequest[]
  commercialDeal CommercialDeal?
  docuSignEnvelopes DocuSignEnvelope[]
  capacityRequests CapacityPlanningRequest[]
  recurringBillings RecurringBillingSchedule[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([customerId, status])
  @@index([secopProcessId])
  @@index([endsAt])
  @@index([costCenterId])
}

/// Snapshot local de oportunidades SECOP II (B2G)
model SecopOpportunity {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processId        String
  title            String
  entityName       String
  modality         String
  status           String       @default("OPEN")
  category         String
  estimatedValue   Decimal?     @db.Decimal(14, 2)
  publishAt        DateTime?
  closeAt          DateTime?
  url              String?
  rawPayload       Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, processId])
  @@index([organizationId, status, closeAt])
  @@index([category, status])
}

/// Oportunidad B2B — pipeline Dirección Comercial
model CommercialDeal {
  id                     String             @id @default(cuid())
  organizationId         String
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                   String
  accountName            String
  customerId             String?
  customer               Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  stage                  SalesPipelineStage @default(NUEVO_LEAD)
  estimatedMonthlyValue  Decimal            @db.Decimal(14, 2) @default(0)
  zone                   String             @default("BOGOTA")
  vehicleType            String?
  distanceKm             Float?
  ownerUserId            String?
  /// Sector comercial (round-robin / conversión)
  sector                 String             @default("GENERAL")
  /// SLA de primer contacto (Módulo 15)
  assignedAt             DateTime?
  firstContactAt         DateTime?
  slaDeadlineAt          DateTime?
  slaStatus              LeadSlaStatus      @default(OK)
  slaBreached            Boolean            @default(false)
  reassignedFromUserId   String?
  reassignedAt           DateTime?
  npsScore               Float?
  portfolioCompliancePct Float?
  contractId             String?            @unique
  contract               TransportContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  costCenterId           String?            @unique
  costCenter             CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  wonAt                  DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  quotes            CommercialIntelligentQuote[]
  envelopes         DocuSignEnvelope[]
  capacityRequests  CapacityPlanningRequest[]
  recurringBillings RecurringBillingSchedule[]
  advancePayments   CommercialAdvancePaymentLink[]
  callLogs          CommercialCallLog[]
  tasks             CommercialTask[]
  timelineEvents    CommercialTimelineEvent[]

  @@unique([organizationId, code])
  @@index([organizationId, stage])
  @@index([customerId])
  @@index([wonAt])
  @@index([ownerUserId, stage])
  @@index([slaStatus, assignedAt])
  @@index([sector, ownerUserId])
}

/// Cotización inteligente B2B (costo real $/km + guardrails de margen)
model CommercialIntelligentQuote {
  id                 String      @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId             String
  deal               CommercialDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  costPerKmReal      Decimal     @db.Decimal(14, 4)
  proposedRatePerKm  Decimal     @db.Decimal(14, 4)
  marginPct          Float
  discountPct        Float       @default(0)
  fuelCostPerKm      Decimal     @db.Decimal(14, 4)
  tireCostPerKm      Decimal     @db.Decimal(14, 4)
  salaryCostPerKm    Decimal     @db.Decimal(14, 4)
  workshopCostPerKm  Decimal     @db.Decimal(14, 4)
  requiresCfoApproval Boolean    @default(false)
  cfoApproved        Boolean     @default(false)
  cfoApprovedAt      DateTime?
  /// Escalamiento descuento gestor (> 5%)
  discountEscalationPending Boolean @default(false)
  /// Aprobación Nivel 1 — Coordinador Comercial
  coordinatorApproved Boolean @default(false)
  coordinatorApprovedAt DateTime?
  coordinatorApprovedById String?
  /// Condiciones de aprobación (ej. firma a 2 años)
  approvalConditions Json?
  escalatedToCfo     Boolean @default(false)
  ebitdaImpactPct    Float?
  createdById        String?
  sentAt             DateTime?
  openedAt           DateTime?
  pdfRef             String?
  status             QuoteStatus @default(DRAFT)
  calcJson           Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([organizationId, createdAt])
  @@index([dealId, status])
  @@index([createdById, createdAt])
  @@index([discountEscalationPending, escalatedToCfo])
}

/// Sobre de firma electrónica (DocuSign / AdobeSign mock)
model DocuSignEnvelope {
  id                  String                 @id @default(cuid())
  organizationId      String
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId              String
  deal                CommercialDeal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contractId          String?
  contract            TransportContract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  provider            String                 @default("DOCUSIGN_MOCK")
  externalEnvelopeId  String
  status              DocuSignEnvelopeStatus @default(CREATED)
  signerEmail         String
  signedAt            DateTime?
  meta                Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([organizationId, externalEnvelopeId])
  @@index([dealId, status])
  @@index([contractId])
}

/// Requerimiento a Capacity Planning (Torre) al cerrar ganado
model CapacityPlanningRequest {
  id               String   @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId           String
  deal             CommercialDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contractId       String?
  contract         TransportContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  vehiclesRequired Int      @default(1)
  routeLabel       String
  status           String   @default("PENDING")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId, status])
  @@index([dealId])
}

/// Facturación recurrente programada en Tesorería al cerrar ganado
model RecurringBillingSchedule {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId         String
  deal           CommercialDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contractId     String?
  contract       TransportContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  customerId     String?
  amountMonthly  Decimal  @db.Decimal(14, 2)
  currency       String   @default("COP")
  dayOfMonth     Int      @default(1)
  nextInvoiceAt  DateTime
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, active, nextInvoiceAt])
  @@index([dealId])
}

/// Link de cobro anticipado (PSE/Tarjeta) — bloquea pase a Despacho hasta PAID
model CommercialAdvancePaymentLink {
  id                   String               @id @default(cuid())
  organizationId       String
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                 String
  token                String               @unique
  amount               Decimal              @db.Decimal(14, 2)
  currency             String               @default("COP")
  method               AdvancePaymentMethod @default(PSE)
  status               AdvancePaymentStatus @default(PENDING)
  checkoutUrl          String
  customerId           String?
  customer             Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealId               String?
  deal                 CommercialDeal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  tripId               String?              @unique
  trip                 Trip?                @relation(fields: [tripId], references: [id], onDelete: SetNull)
  createdById          String
  paidAt               DateTime?
  treasuryConfirmedAt  DateTime?
  treasuryConfirmedById String?
  /// false mientras PENDING — Despacho no puede tomar la tarjeta
  dispatchUnlocked     Boolean              @default(false)
  meta                 Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([createdById, status])
  @@index([dealId])
}

/// Llamada del marcador integrado + notas de voz
model CommercialCallLog {
  id                   String    @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUserId          String
  customerId           String?
  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealId               String?
  deal                 CommercialDeal? @relation(fields: [dealId], references: [id], onDelete: SetNull)
  phone                String
  direction            String    @default("OUTBOUND")
  durationSec          Int?
  outcome              String?
  voiceNoteRef         String?
  voiceNoteTranscript  String?
  startedAt            DateTime  @default(now())
  endedAt              DateTime?
  priorityScore        Int       @default(50)
  createdAt            DateTime  @default(now())

  tasks CommercialTask[]

  @@index([organizationId, ownerUserId, startedAt])
  @@index([customerId, startedAt])
  @@index([dealId])
}

/// Tareas diarias del gestor (llamadas / correos / reuniones)
model CommercialTask {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUserId    String
  kind           CommercialTaskKind @default(CALL)
  title          String
  dueAt          DateTime
  completedAt    DateTime?
  priority       Int                @default(50)
  customerId     String?
  customer       Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           CommercialDeal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  callLogId      String?
  callLog        CommercialCallLog? @relation(fields: [callLogId], references: [id], onDelete: SetNull)
  meta           Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, ownerUserId, dueAt])
  @@index([completedAt])
}

/// Timeline estilo muro — interacciones del cliente
model CommercialTimelineEvent {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           CommercialDeal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  ownerUserId    String?
  kind           CommercialTimelineKind
  title          String
  body           String?
  meta           Json?
  createdAt      DateTime               @default(now())

  @@index([organizationId, customerId, createdAt])
  @@index([dealId, createdAt])
  @@index([ownerUserId, createdAt])
}

/// Proyecto de licitación B2G / SECOP — Bidding Tracker
model BiddingProject {
  id                 String               @id @default(cuid())
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code               String
  title              String
  processId          String?
  entityName         String
  modality           String               @default("Licitación pública")
  category           String               @default("ESPECIAL")
  estimatedValue     Decimal?             @db.Decimal(14, 2)
  /// Fecha límite inamovible del proceso SECOP
  closeAt            DateTime
  status             BiddingProjectStatus @default(OPEN)
  progressPct        Float                @default(0)
  secopOpportunityId String?
  createdById        String
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  tasks BiddingProjectTask[]

  @@unique([organizationId, code])
  @@index([organizationId, status, closeAt])
  @@index([processId])
}

model BiddingProjectTask {
  id             String            @id @default(cuid())
  projectId      String
  project        BiddingProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department     BiddingTaskDept
  title          String
  /// Deadline inamovible interdepartamental
  dueAt          DateTime
  status         BiddingTaskStatus @default(PENDING)
  assigneeHint   String?
  completedAt    DateTime?
  immutableDue   Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([projectId, department])
  @@index([dueAt, status])
}

// =============================================================================
// 7. TESORERÍA / CONTABILIDAD / REVISORÍA
// =============================================================================

model Invoice {
  id                 String        @id @default(cuid())
  number             String
  type               InvoiceType
  status             InvoiceStatus @default(DRAFT)
  counterparty       String
  amount             Decimal       @db.Decimal(14, 2)
  dueDate            DateTime?
  paidAt             DateTime?
  xmlHash            String?
  dianPayload        Json?
  paymentApproved    Boolean       @default(false)
  paymentApprovedAt  DateTime?
  paymentApprovedById String?
  paymentApprovedBy  User?         @relation("InvoicePaymentApprover", fields: [paymentApprovedById], references: [id], onDelete: SetNull)
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId         String?
  supplier           Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  tripId             String?
  trip               Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  threeWayMatches ThreeWayMatch[]
  paymentSchedules PaymentSchedule[]
  /// Prefactura / anexo B2B
  prefacturaAnnex  Json?
  dianCufe         String?
  dianStampedAt    DateTime?
  dianXmlRef       String?
  dianPdfRef       String?

  @@unique([organizationId, number])
  @@index([organizationId, type, status])
  @@index([organizationId, dueDate])
  @@index([purchaseOrderId])
  @@index([tripId])
  @@index([xmlHash])
  @@index([status, dueDate])
  @@index([dianCufe])
}

enum ExpenseLegalizationStatus {
  OPEN
  IN_REVIEW
  CLOSED
  ADJUSTED_PAYROLL
  REFUND_PENDING
}

/// Legalización de viáticos / caja menor (conductores) — Módulo 4.1
model ExpenseLegalization {
  id               String                     @id @default(cuid())
  organizationId   String
  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  driverId         String?
  driverUserId     String?
  driverName       String?
  advanceAmount    Decimal                    @db.Decimal(14, 2) @default(0)
  expensesTotal    Decimal                    @db.Decimal(14, 2) @default(0)
  balance          Decimal                    @db.Decimal(14, 2) @default(0)
  /// COMPANY_CREDIT | DRIVER_CREDIT | ZERO
  settlementKind   String?
  status           ExpenseLegalizationStatus  @default(OPEN)
  supportFileRef   String?
  notes            String?
  reviewedById     String?
  closedAt         DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  lines            ExpenseLegalizationLine[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([driverId])
}

model ExpenseLegalizationLine {
  id               String              @id @default(cuid())
  legalizationId   String
  legalization     ExpenseLegalization @relation(fields: [legalizationId], references: [id], onDelete: Cascade)
  source           String              @default("SMART_WALLET") // SMART_WALLET | MANUAL
  description      String
  amount           Decimal             @db.Decimal(14, 2)
  receiptRef       String?
  spentAt          DateTime?
  createdAt        DateTime            @default(now())

  @@index([legalizationId])
}

enum BankReconciliationStatus {
  OPEN
  PARTIAL
  CLOSED
}

/// Extracto bancario cargado (.CSV/Excel) — conciliación diaria
model BankStatement {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankName       String?
  accountMask    String?
  periodDate     DateTime
  fileName       String?
  rawRows        Json?
  uploadedById   String?
  createdAt      DateTime @default(now())
  lines          BankStatementLine[]
  reconciliation BankReconciliation?

  @@index([organizationId, periodDate])
}

model BankStatementLine {
  id            String        @id @default(cuid())
  statementId   String
  statement     BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  externalRef   String?
  description   String
  amount        Decimal       @db.Decimal(14, 2)
  bookedAt      DateTime?
  matched       Boolean       @default(false)
  invoiceId     String?
  matchScore    Float?
  createdAt     DateTime      @default(now())

  @@index([statementId, matched])
  @@index([invoiceId])
}

model BankReconciliation {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statementId    String                   @unique
  statement      BankStatement            @relation(fields: [statementId], references: [id], onDelete: Cascade)
  status         BankReconciliationStatus @default(OPEN)
  matchedCount   Int                      @default(0)
  unmatchedCount Int                      @default(0)
  closedAt       DateTime?
  closedById     String?
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([organizationId, status])
}

/// Contador de productividad del auxiliar (jornada)
model AuxiliarProductivityLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  workDate       DateTime @db.Date
  documentsCount Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId, workDate])
  @@index([userId, workDate])
}

// =============================================================================
// 7b. TESORERÍA — PaymentSchedule (Zero-Touch) + Rodamientos
// =============================================================================

enum PaymentScheduleStatus {
  PENDING
  QUEUED
  DISBURSED
  FAILED
  CANCELLED
}

enum RodamientoLiquidationStatus {
  DRAFT
  LIQUIDATED
  PAID
  CANCELLED
}

/// Obligación de pago generada tras 3-Way Match APPROVED
model PaymentSchedule {
  id               String                @id @default(cuid())
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId        String
  invoice          Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  purchaseOrderId  String?
  threeWayMatchId  String?
  amount           Decimal               @db.Decimal(14, 2)
  currency         String                @default("COP")
  counterparty     String
  status           PaymentScheduleStatus @default(QUEUED)
  dueDate          DateTime?
  queuedAt         DateTime              @default(now())
  disbursedAt      DateTime?
  disbursedById    String?
  disbursedBy      User?                 @relation("PaymentDisburser", fields: [disbursedById], references: [id], onDelete: SetNull)
  mfaVerified      Boolean               @default(false)
  bankRef          String?
  failureReason    String?
  meta             Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([invoiceId])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([status, queuedAt])
  @@index([threeWayMatchId])
}

/// Liquidación periódica de rodamientos (conductores / propietarios)
model RodamientoLiquidation {
  id             String                      @id @default(cuid())
  organizationId String
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  periodFrom     DateTime
  periodTo       DateTime
  vehicleId      String?
  driverId       String?
  tripCount      Int                         @default(0)
  amount         Decimal                     @db.Decimal(14, 2)
  status         RodamientoLiquidationStatus @default(LIQUIDATED)
  details        Json?
  liquidatedById String?
  liquidatedBy   User?                       @relation("RodamientoLiquidator", fields: [liquidatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, periodFrom, periodTo])
  @@index([driverId])
  @@index([vehicleId])
}

model Account {
  id             String       @id @default(cuid())
  code           String
  name           String
  type           AccountType
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  debitLines  JournalLine[] @relation("DebitAccount")
  creditLines JournalLine[] @relation("CreditAccount")

  @@unique([organizationId, code])
  @@index([organizationId, type])
}

model JournalEntry {
  id             String             @id @default(cuid())
  memo           String
  status         JournalEntryStatus @default(DRAFT)
  postedAt       DateTime?
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lines JournalLine[]

  @@index([organizationId, status])
  @@index([organizationId, postedAt])
}

model JournalLine {
  id             String       @id @default(cuid())
  entryId        String
  entry          JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  debitAccountId String
  debitAccount   Account      @relation("DebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccountId String
  creditAccount  Account      @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)
  amount         Decimal      @db.Decimal(14, 2)
  /// Centro de costo por placa (ej. BOG-892)
  costCenterPlate String?

  @@index([entryId])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([costCenterPlate])
}

/// Centro de costo contable vinculado a placa / vehículo / contrato B2B
model CostCenter {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  /// Placa canónica (ABC-123) o identificador B2B (B2B-CTR-…)
  plate          String
  vehicleId      String?
  name           String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  commercialDeal CommercialDeal?
  contracts      TransportContract[]

  @@unique([organizationId, plate])
  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([vehicleId])
}

/// Timbrado DIAN — traza de emisión FE
model DianEmission {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  cufe           String
  provider       String   @default("DIAN_MOCK")
  xmlRef         String?
  pdfRef         String?
  stampedAt      DateTime @default(now())
  payload        Json?
  createdAt      DateTime @default(now())

  @@unique([invoiceId])
  @@index([organizationId, stampedAt])
  @@index([cufe])
}

model ForensicFinding {
  id             String       @id @default(cuid())
  code           String       @default(cuid())
  title          String
  severity       String
  detail         String
  amount         Decimal?     @db.Decimal(14, 2)
  status         String       @default("OPEN")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, severity])
}

/// Periodo contable — Hard Lock de Revisoría Fiscal (Truth Hub)
model AccountingPeriod {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// YYYY-MM
  yearMonth      String
  status         AccountingPeriodStatus  @default(OPEN)
  hardLockedAt   DateTime?
  hardLockedById String?
  dictamenId     String?                 @unique
  dictamen       FiscalDictamen?         @relation(fields: [dictamenId], references: [id], onDelete: SetNull)
  meta           Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([organizationId, yearMonth])
  @@index([organizationId, status])
  @@index([status, yearMonth])
}

/// Dictamen de Revisoría Fiscal (PDF + firma digital)
model FiscalDictamen {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  yearMonth       String
  pdfRef          String
  signatureHash   String
  signedAt        DateTime     @default(now())
  signedById      String?
  opinion         String       @default("SIN_SALVEDADES")
  notes           String?
  meta            Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  period          AccountingPeriod?

  @@unique([organizationId, yearMonth])
  @@index([organizationId, signedAt])
  @@index([signatureHash])
}

/// Nota de auditoría fiscal — etiqueta Contabilidad / DIAN
model FiscalAuditNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String?
  yearMonth      String?
  taggedModule   String       @default("CONTABILIDAD")
  title          String
  body           String
  severity       String       @default("MEDIUM")
  status         String       @default("OPEN")
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([invoiceId])
  @@index([yearMonth])
}

// =============================================================================
// 8. RRHH · RECEPCIÓN/CALL · HQSE · SARLAFT · ARCHIVO · PARQUEADERO · TI
// =============================================================================

model Employee {
  id             String         @id @default(cuid())
  name           String
  document       String
  title          String
  area           String
  status         EmployeeStatus @default(ACTIVE)
  fatigueScore   Int            @default(0)
  sarlaftBlocked Boolean        @default(false)
  sarlaftRiskScore Int          @default(0)
  /// Salario base periódico (COP)
  baseSalary     Decimal        @db.Decimal(14, 2) @default(0)
  /// Tarifa hora ordinaria (COP) — overtime / nocturno
  hourlyRate     Decimal        @db.Decimal(14, 2) @default(0)
  email          String?
  phone          String?
  /// Cuenta de acceso Fleetline vinculada al expediente
  userId         String?        @unique
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  address        String?
  city           String?
  contractType   String?
  hireDate       DateTime?
  eps            String?
  arl            String?
  pensionFund    String?
  compensationFund String?
  bankName       String?
  bankAccountType String?
  bankAccountNumber String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  terminatedAt   DateTime?
  terminationReason String?
  /// Vínculo opcional a perfil conductor (fatiga / comisiones)
  driverId       String?        @unique
  driver         Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  payrollLines PayrollLine[]

  @@unique([organizationId, document])
  @@index([organizationId, status])
  @@index([organizationId, area])
  @@index([organizationId, sarlaftBlocked])
  @@index([fatigueScore])
}

/// Turno laboral conductor — telemetría de fatiga (check-in / check-out)
model DriverShift {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  driverId         String
  driver           Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  checkInAt        DateTime
  checkOutAt       DateTime?
  status           ShiftStatus  @default(OPEN)
  continuousHours  Float?
  notes            String?
  meta             Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, driverId, checkInAt])
  @@index([driverId, status])
  @@index([organizationId, status])
}

model PayrollRun {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodStart      DateTime
  periodEnd        DateTime
  status           PayrollRunStatus @default(DRAFT)
  totalGross       Decimal          @db.Decimal(14, 2) @default(0)
  totalOvertime    Decimal          @db.Decimal(14, 2) @default(0)
  totalNight       Decimal          @db.Decimal(14, 2) @default(0)
  totalCommissions Decimal          @db.Decimal(14, 2) @default(0)
  totalNet         Decimal          @db.Decimal(14, 2) @default(0)
  calculatedAt     DateTime?
  meta             Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lines PayrollLine[]

  @@index([organizationId, periodStart, periodEnd])
  @@index([organizationId, status])
}

model PayrollLine {
  id              String     @id @default(cuid())
  payrollRunId    String
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  driverId        String?
  driver          Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  baseSalary      Decimal    @db.Decimal(14, 2) @default(0)
  ordinaryHours   Float      @default(0)
  overtimeHours   Float      @default(0)
  overtimeAmount  Decimal    @db.Decimal(14, 2) @default(0)
  nightHours      Float      @default(0)
  nightAmount     Decimal    @db.Decimal(14, 2) @default(0)
  completedTrips  Int        @default(0)
  tripCommissions Decimal    @db.Decimal(14, 2) @default(0)
  grossTotal      Decimal    @db.Decimal(14, 2) @default(0)
  meta            Json?
  createdAt       DateTime   @default(now())

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([driverId])
}

model Ticket {
  id               String          @id @default(cuid())
  code             String
  subject          String
  requester        String
  channel          TicketChannel   @default(PHONE)
  message          String
  status           TicketStatus    @default(OPEN)
  priority         TicketPriority  @default(MEDIUM)
  /// Clasificación PQRS (null = ticket helpdesk genérico)
  pqrsType         PqrsType?
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicleId        String?
  vehicle          Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId         String?
  driver           Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  /// SLA automático (horas / vencimiento)
  slaHours         Int?
  slaDueAt         DateTime?
  slaBreached      Boolean         @default(false)
  resolvedAt       DateTime?
  resolutionNotes  String?
  /// Escalamiento trazabilidad hoja de vida
  escalatedToRrhh  Boolean         @default(false)
  escalatedToHqse  Boolean         @default(false)
  assigneeId       String?
  assignee         User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meta             Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, priority, status])
  @@index([organizationId, pqrsType, status])
  @@index([customerId, status])
  @@index([assigneeId, status])
  @@index([channel, status])
  @@index([slaDueAt, status])
  @@index([driverId])
  @@index([vehicleId])
  @@index([createdAt])
}

model Visitor {
  id             String           @id @default(cuid())
  name           String
  document       String
  company        String?
  reason         String
  hostName       String
  kind           VisitorKind      @default(VISITOR)
  /// Candidato / proveedor / B2B — dispara notificaciones de área
  visitClass     VisitClass       @default(OTHER)
  boardStatus    VisitBoardStatus @default(WAITING)
  /// Gafete RFID entregado en portería
  badgeRfid      String?
  hostUserId     String?
  siteLabel      String?
  phone          String?
  /// ARL vigente requerida para contratistas
  arlValid       Boolean          @default(false)
  arlExpiresAt   DateTime?
  passCode       String?
  qrPayload      String?
  badgeIssuedAt  DateTime?
  checkedInAt    DateTime         @default(now())
  checkedOutAt   DateTime?
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meta           Json?

  @@index([organizationId, checkedOutAt])
  @@index([organizationId, boardStatus])
  @@index([organizationId, passCode])
  @@index([document])
  @@index([kind, checkedOutAt])
  @@index([visitClass, boardStatus])
}

model QualityEvent {
  id             String       @id @default(cuid())
  kind           String
  title          String
  status         String       @default("OPEN")
  npsScore       Int?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([kind, createdAt])
}

/// Incidente / accidente de tránsito o hallazgo SST (Módulo 14 HQSE)
model HqseIncident {
  id             String           @id @default(cuid())
  code           String
  kind           IncidentKind     @default(TRAFFIC_ACCIDENT)
  severity       IncidentSeverity
  status         IncidentStatus   @default(OPEN)
  title          String
  description    String?
  occurredAt     DateTime
  location       String?
  vehicleId      String?
  vehicle        Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId       String?
  driver         Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  /// OT de peritaje abierta en Taller (07)
  workOrderId    String?
  autoBlocked    Boolean          @default(false)
  reportedById   String?
  meta           Json?
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, severity, status])
  @@index([organizationId, occurredAt])
  @@index([vehicleId, severity])
  @@index([driverId, severity])
}

/// Matriz de riesgos PESV / ISO 39001
model PesvRiskControl {
  id               String            @id @default(cuid())
  code             String
  category         String
  title            String
  description      String?
  status           PesvControlStatus @default(PENDING)
  residualRisk     Int               @default(3)
  lastReviewedAt   DateTime?
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([category, status])
}

/// Capacitación conductor (PESV / defensiva / SST)
model HqseTrainingRecord {
  id               String       @id @default(cuid())
  driverId         String
  driver           Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  topic            String
  completedAt      DateTime
  expiresAt        DateTime?
  provider         String?
  certificateRef   String?
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, topic, completedAt])
  @@index([driverId, expiresAt])
}

/// Simulacro de seguridad vial / emergencia
model HqseSafetyDrill {
  id             String       @id @default(cuid())
  code           String
  title          String
  scheduledAt    DateTime
  completedAt    DateTime?
  participants   Int          @default(0)
  result         String?
  notes          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, scheduledAt])
  @@index([completedAt])
}

/// Auditoría interna/externa ISO / PESV
model HqseAudit {
  id               String          @id @default(cuid())
  code             String
  scope            HqseAuditScope  @default(INTERNAL)
  standard         String          @default("ISO_39001")
  title            String
  status           HqseAuditStatus @default(PLANNED)
  auditedAt        DateTime
  findingsCount    Int             @default(0)
  nonConformities  Int             @default(0)
  score            Int?
  auditorName      String?
  notes            String?
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status, auditedAt])
  @@index([standard, scope])
}

model SarlaftCheck {
  id               String             @id @default(cuid())
  subjectName      String
  document         String
  risk             SarlaftRisk        @default(LOW)
  /// Score 0–100 (umbral bloqueo >= 80)
  riskScore        Int                @default(0)
  entityType       SarlaftEntityType?
  entityId         String?
  /// Listas con hit: OFAC | ONU | PEPS | NACIONAL
  listsMatched     String[]
  status           SarlaftAlertStatus @default(PENDING)
  notes            String?
  graphPayload     Json?
  customerId       String?
  customer         Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedBy       User?              @relation("SarlaftResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNotes  String?
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  evidences        SarlaftEvidence[]

  @@index([organizationId, risk])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([document])
  @@index([customerId])
  @@index([riskScore])
}

/// Evidencia de consulta SARLAFT (policía, procuraduría, registraduría, antecedentes)
model SarlaftEvidence {
  id             String                @id @default(cuid())
  checkId        String
  check          SarlaftCheck          @relation(fields: [checkId], references: [id], onDelete: Cascade)
  source         SarlaftEvidenceSource
  title          String
  fileRef        String?
  originalName   String?
  mimeType       String?
  byteSize       Int?
  contentHash    String?
  uploadedById   String?
  uploadedBy     User?                 @relation("SarlaftEvidenceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime              @default(now())

  @@index([checkId, createdAt])
  @@index([organizationId, source])
}

model ArchiveDocument {
  id               String                  @id @default(cuid())
  title            String
  category         ArchiveCategory         @default(OTHER)
  docType          ArchiveDocType          @default(OTHER)
  validationStatus ArchiveValidationStatus @default(PENDING)
  tags             String[]
  contentHash      String?
  fileRef          String?
  originalName     String?
  mimeType         String?
  byteSize         Int?
  /// Vínculo polimórfico Data Room
  entityType       ArchiveEntityType?
  entityId         String?
  vehicleId        String?
  vehicle          Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId         String?
  driver           Driver?                 @relation(fields: [driverId], references: [id], onDelete: SetNull)
  supplierId       String?
  supplier         Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrderId  String?
  purchaseOrder    PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  /// Metadatos OCR estructurados
  plate            String?
  taxIdOrDocument  String?
  issuer           String?
  amount           Decimal?                @db.Decimal(14, 2)
  issuedAt         DateTime?
  expiresAt        DateTime?
  ocrPayload       Json?
  ocrProcessedAt   DateTime?
  uploadedById     String?
  uploadedBy       User?                   @relation("ArchiveUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  deletedAt        DateTime?
  /// Custodia física — Pasillo / Estante / Caja
  aisle            String?
  shelf            String?
  box              String?
  /// Pendiente de digitalizar (escaneo solicitado)
  pendingDigitization Boolean              @default(false)
  /// AVAILABLE | ON_LOAN
  custodyStatus    String                  @default("AVAILABLE")
  organizationId   String
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  loans            DocumentLoan[]

  @@index([organizationId, category])
  @@index([organizationId, docType])
  @@index([organizationId, validationStatus])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, pendingDigitization])
  @@index([organizationId, custodyStatus])
  @@index([vehicleId])
  @@index([driverId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([contentHash])
  @@index([title])
  @@index([plate])
  @@index([taxIdOrDocument])
  @@index([deletedAt])
}

/// Inventario administrativo — papelería / dotación (Módulo 3)
model StationeryItem {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku            String
  name           String
  unit           String   @default("UND")
  quantity       Int      @default(0)
  /// Umbral de reorden (alerta Kafka si quantity <= minStock)
  minStock       Int      @default(5)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  dispatches     StationeryDispatch[]

  @@unique([organizationId, sku])
  @@index([organizationId, quantity])
  @@index([organizationId, minStock])
}

model StationeryDispatch {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           StationeryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity       Int
  ticketRef      String?
  notes          String?
  requestedById  String?
  dispatchedById String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([itemId, createdAt])
}

/// Préstamo de carpeta / documento físico
model DocumentLoan {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String
  document       ArchiveDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  borrowerUserId String
  borrowerName   String?
  purpose        String?
  status         String   @default("ON_LOAN") // ON_LOAN | RETURNED | OVERDUE
  checkedOutAt   DateTime @default(now())
  dueAt          DateTime?
  returnedAt     DateTime?
  reminderSentAt DateTime?
  checkedOutById String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status, checkedOutAt])
  @@index([documentId, status])
  @@index([borrowerUserId])
}

enum YardAccessKind {
  CHECK_IN
  CHECK_OUT
}

enum YardInspectionPhase {
  CHECK_IN
  CHECK_OUT
  SPOT_CHECK
}

model ParkingLog {
  id             String       @id @default(cuid())
  plate          String
  driverName     String?
  guardName      String?
  checkedInAt    DateTime     @default(now())
  checkedOutAt   DateTime?
  odometerInKm   Int?
  odometerOutKm  Int?
  driverId       String?
  driver         Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  accessLogs   YardAccessLog[]
  inspections  YardInspection[]

  @@index([organizationId, checkedOutAt])
  @@index([plate, checkedInAt])
  @@index([vehicleId])
  @@index([driverId])
}

/// Evento de talanquera / LPR (Smart Gate)
model YardAccessLog {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind            YardAccessKind
  plate           String
  vehicleId       String?
  vehicle         Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId        String?
  driver          Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  parkingLogId    String?
  parkingLog      ParkingLog?    @relation(fields: [parkingLogId], references: [id], onDelete: SetNull)
  odometerKm      Int?
  gateId          String?
  cameraRef       String?
  lprConfidence   Float?
  gateOpened      Boolean        @default(false)
  denied          Boolean        @default(false)
  denyReason      String?
  meta            Json?
  createdAt       DateTime       @default(now())

  @@index([organizationId, kind, createdAt])
  @@index([vehicleId, createdAt])
  @@index([plate, createdAt])
  @@index([parkingLogId])
}

/// Acta de inspección física de patio (CV / inventario)
model YardInspection {
  id                   String              @id @default(cuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicleId            String
  vehicle              Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  parkingLogId         String?
  parkingLog           ParkingLog?         @relation(fields: [parkingLogId], references: [id], onDelete: SetNull)
  phase                YardInspectionPhase @default(CHECK_IN)
  fuelLevelPct         Int?
  tireCondition        String?
  visualDamageNotes    String?
  criticalSafetyFault  Boolean             @default(false)
  criticalFaultDetail  String?
  photoRefs            String[]
  inspectorName        String?
  workOrderId          String?
  meta                 Json?
  createdAt            DateTime            @default(now())

  @@index([organizationId, createdAt])
  @@index([vehicleId, createdAt])
  @@index([criticalSafetyFault, createdAt])
  @@index([parkingLogId])
}

model YardEvent {
  id             String       @id @default(cuid())
  kind           String // ENTRY | EXIT | DAMAGE_CV | GATE_DENY
  payload        Json?
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, kind, createdAt])
  @@index([vehicleId, createdAt])
}

/// Cola de lavado priorizada — Smart Yard App
model YardWashJob {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plate          String
  vehicleId      String?
  priority       Int      @default(50)
  status         String   @default("QUEUED") // QUEUED | WASHING | DONE | SKIPPED
  bayCode        String?
  notes          String?
  assignedToId   String?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status, priority])
  @@index([plate])
}

/// Parqueo inteligente LIFO — carril/bahía por hora de salida
model YardParkingSlot {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  laneCode       String
  bayCode        String
  plate          String?
  vehicleId      String?
  scheduledDepartAt DateTime?
  occupiedAt     DateTime?
  status         String   @default("FREE") // FREE | OCCUPIED | RESERVED
  meta           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, laneCode, bayCode])
  @@index([organizationId, status, scheduledDepartAt])
  @@index([plate])
}

/// Alcoholimetría previa a salida de talanquera
model AlcoholCheck {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  driverId       String?
  plate          String?
  passed         Boolean
  readingMgL     Float?
  checkedAt      DateTime @default(now())
  expiresAt      DateTime?
  meta           Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, driverId, checkedAt])
  @@index([plate, checkedAt])
  @@index([passed, expiresAt])
}

/// SOS Pilot App — multicanal
model PilotSosAlert {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  category       String   // CHOQUE | FALLA_MECANICA | ORDEN_PUBLICO
  tripId         String?
  vehicleId      String?
  plate          String?
  driverId       String?
  lat            Float?
  lng            Float?
  speedKph       Float?
  voipChannel    String?
  status         String   @default("ACTIVE")
  meta           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status, createdAt])
  @@index([tripId])
}

/// Token QR tanqueo — billetera virtual sin efectivo
model FuelWalletToken {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenQr        String   @unique
  driverId       String?
  plate          String?
  amountCop      Decimal  @db.Decimal(14, 2)
  status         String   @default("ACTIVE") // ACTIVE | REDEEMED | EXPIRED
  expiresAt      DateTime?
  redeemedAt     DateTime?
  meta           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
  @@index([driverId, status])
}

/// Conflicto interdepartamental — Subgerencia árbitro N2
model SubgerenciaConflict {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  title          String
  parties        String[] // TALLER | LOGISTICA | PATIO | COMERCIAL
  status         String   @default("OPEN") // OPEN | RESOLVED | ESCALATED
  resolution     String?
  resolvedById   String?
  resolvedAt     DateTime?
  level          Int      @default(2)
  meta           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

/// Proyecto estratégico Subgerencia — mejora continua
model SubgerenciaProject {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  title          String
  status         String   @default("BACKLOG") // BACKLOG | IN_PROGRESS | DONE
  kind           String   @default("EFICIENCIA") // EFICIENCIA | SATELITE | DEADHEAD
  deadheadKmSaved Float?
  ownerId        String?
  meta           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

// =============================================================================
// 8b. CONTINUACIÓN RRHH / SARLAFT (modelos ya definidos arriba en sección 8)
// =============================================================================

model SystemAlert {
  id             String       @id @default(cuid())
  severity       String
  source         String
  message        String
  resolved       Boolean      @default(false)
  resolvedAt     DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, resolved, createdAt])
  @@index([severity, resolved])
}

/// Inbox unificado (campana web + in-app móvil)
model UserNotification {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           NotificationKind    @default(SYSTEM)
  title          String
  body           String
  href           String?
  payload        Json?
  channels       NotificationChannel[]
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([organizationId, createdAt])
  @@index([kind, createdAt])
}

/// Suscripción Web Push (VAPID / Push API del navegador)
model WebPushSubscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, endpoint])
  @@index([organizationId, userId])
}

/// Token push remoto (Expo / FCM / APNs)
model DevicePushToken {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       DevicePlatform
  token          String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, token])
  @@index([organizationId, platform])
}

/// Log centralizado NOC / Event Mesh (Módulo 17)
model SystemLog {
  id             String         @id @default(cuid())
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  level          SystemLogLevel @default(INFO)
  source         String
  message        String
  correlationId  String?
  meta           Json?
  createdAt      DateTime       @default(now())

  @@index([organizationId, createdAt])
  @@index([level, createdAt])
  @@index([source, createdAt])
  @@index([correlationId])
}

/// Mensaje en Dead-Letter Queue Kafka
model KafkaDlqMessage {
  id             String          @id @default(cuid())
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  topic          String
  originalTopic  String?
  partition      Int             @default(0)
  offset         String?
  payload        Json
  errorMessage   String
  attempts       Int             @default(0)
  status         DlqMessageStatus @default(PENDING)
  lastErrorAt    DateTime        @default(now())
  replayedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, lastErrorAt])
  @@index([topic, status])
  @@index([organizationId, status])
}

/// Job Speech-to-Text / Text-to-Speech (Gemini STTS mock)
model SttsJob {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mode           SttsMode
  status         SttsJobStatus @default(PENDING)
  provider       String        @default("GEMINI_STTS_MOCK")
  inputRef       String?
  inputText      String?
  outputText     String?
  audioRef       String?
  mimeType       String?
  durationMs     Int?
  confidence     Float?
  meta           Json?
  errorMessage   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, mode, createdAt])
  @@index([status, createdAt])
}

model SystemTicket {
  id             String        @id @default(cuid())
  title          String
  detail         String?
  status         String        @default("OPEN")
  /// HIGH | MEDIUM | LOW
  priority       String        @default("MEDIUM")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([organizationId, priority, status])
}

/// Link de un solo uso — onboarding / reset seguro (Módulo 2 TI)
model TiOnboardingLink {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  targetRole     RoleCode  @default(CONDUCTOR)
  tokenHash      String
  expiresAt      DateTime
  usedAt         DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@index([organizationId, email])
  @@index([tokenHash])
  @@index([expiresAt])
}

/// Emparejamiento MDM móvil — QR temporal (FSG Pilot App)
model TiMdmPairSession {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pairCode       String
  driverUserId   String?
  deviceId       String?
  locked         Boolean   @default(true)
  expiresAt      DateTime
  pairedAt       DateTime?
  createdById    String?
  meta           Json?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, pairCode])
  @@index([organizationId, expiresAt])
  @@index([driverUserId])
}

// =============================================================================
// 9. APPS MÓVILES — MONITORA · PADRES · PASAJEROS (núcleo)
// =============================================================================

model MonitorProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  boardingEvents BoardingEvent[]
  schoolRoutes   SchoolRoute[]
  schoolRuns     SchoolRouteRun[]
}

model FamilyProfile {
  id             String       @id @default(cuid())
  name           String
  phone          String?
  pushToken      String?
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  dependents    Dependent[]
  notifications ParentNotification[]

  @@index([organizationId])
  @@index([customerId])
}

model Dependent {
  id             String            @id @default(cuid())
  name           String
  document       String?
  familyId       String
  family         FamilyProfile     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  boardingEvents BoardingEvent[]
  schoolStudent  SchoolStudent?

  @@index([familyId])
}

/// Estudiante escolar (QR/NFC) — vínculo opcional a Dependent/familia
model SchoolStudent {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  document       String?
  qrCode         String
  nfcUid         String?
  schoolName     String?
  grade          String?
  currentStatus  StudentTripStatus @default(PENDING)
  dependentId    String?           @unique
  dependent      Dependent?        @relation(fields: [dependentId], references: [id], onDelete: SetNull)
  familyId       String?
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  assignments    SchoolStudentAssignment[]
  boardingEvents SchoolBoardingEvent[]
  novelties      SchoolNovelty[]
  notifications  ParentNotification[]

  @@unique([organizationId, qrCode])
  @@index([organizationId, currentStatus])
  @@index([nfcUid])
  @@index([familyId])
}

model SchoolRoute {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  direction      SchoolRouteDirection @default(TO_SCHOOL)
  active         Boolean              @default(true)
  vehicleId      String?
  vehicle        Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId       String?
  driver         Driver?              @relation(fields: [driverId], references: [id], onDelete: SetNull)
  monitorId      String?
  monitor        MonitorProfile?      @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  /// Última posición reportada del bus
  lastLat        Float?
  lastLng        Float?
  lastLocatedAt  DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  stops       SchoolStop[]
  assignments SchoolStudentAssignment[]
  runs        SchoolRouteRun[]
  boardingEvents SchoolBoardingEvent[]
  novelties   SchoolNovelty[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([vehicleId])
  @@index([monitorId])
}

model SchoolStop {
  id           String         @id @default(cuid())
  schoolRouteId String
  schoolRoute  SchoolRoute    @relation(fields: [schoolRouteId], references: [id], onDelete: Cascade)
  sequence     Int
  name         String
  address      String?
  kind         SchoolStopKind @default(PICKUP)
  lat          Float?
  lng          Float?

  assignments SchoolStudentAssignment[]

  @@index([schoolRouteId, sequence])
}

model SchoolStudentAssignment {
  id            String        @id @default(cuid())
  schoolRouteId String
  schoolRoute   SchoolRoute   @relation(fields: [schoolRouteId], references: [id], onDelete: Cascade)
  studentId     String
  student       SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stopId        String?
  stop          SchoolStop?   @relation(fields: [stopId], references: [id], onDelete: SetNull)
  active        Boolean       @default(true)

  @@unique([schoolRouteId, studentId])
  @@index([studentId, active])
}

model SchoolRouteRun {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolRouteId  String
  schoolRoute    SchoolRoute          @relation(fields: [schoolRouteId], references: [id], onDelete: Cascade)
  status         SchoolRouteRunStatus @default(PLANNED)
  monitorId      String?
  monitor        MonitorProfile?      @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  startedAt      DateTime?
  endedAt        DateTime?
  startLat       Float?
  startLng       Float?
  endLat         Float?
  endLng         Float?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  boardingEvents SchoolBoardingEvent[]
  novelties      SchoolNovelty[]

  @@index([organizationId, status])
  @@index([schoolRouteId, status])
  @@index([startedAt])
}

model SchoolBoardingEvent {
  id             String               @id @default(cuid())
  organizationId String
  studentId      String
  student        SchoolStudent        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolRouteId  String
  schoolRoute    SchoolRoute          @relation(fields: [schoolRouteId], references: [id], onDelete: Cascade)
  runId          String?
  run            SchoolRouteRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  kind           SchoolBoardingKind
  method         SchoolBoardingMethod @default(QR)
  resultingStatus StudentTripStatus
  lat            Float?
  lng            Float?
  monitorUserId  String?
  createdAt      DateTime             @default(now())

  @@index([studentId, createdAt])
  @@index([schoolRouteId, createdAt])
  @@index([runId, createdAt])
  @@index([organizationId, createdAt])
}

model SchoolNovelty {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           SchoolNoveltyKind
  notes          String?
  schoolRouteId  String?
  schoolRoute    SchoolRoute?      @relation(fields: [schoolRouteId], references: [id], onDelete: SetNull)
  runId          String?
  run            SchoolRouteRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  studentId      String?
  student        SchoolStudent?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  reportedById   String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, createdAt])
  @@index([schoolRouteId, createdAt])
  @@index([studentId])
}

model ParentNotification {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  familyId       String?
  family         FamilyProfile? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  studentId      String?
  student        SchoolStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  title          String
  body           String
  channel        String        @default("PUSH")
  read           Boolean       @default(false)
  payload        Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([familyId, read])
  @@index([studentId, createdAt])
}

model BoardingEvent {
  id          String          @id @default(cuid())
  dependentId String
  dependent   Dependent       @relation(fields: [dependentId], references: [id], onDelete: Cascade)
  monitorId   String?
  monitor     MonitorProfile? @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  kind        String // BOARD | ALIGHT | ABSENT
  lat         Float?
  lng         Float?
  createdAt   DateTime        @default(now())

  @@index([dependentId, createdAt])
  @@index([monitorId, createdAt])
}

model PassengerProfile {
  id             String       @id @default(cuid())
  name           String
  phone          String?
  email          String?
  document       String?
  externalRef    String?
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  rideRequests   RideRequest[]
  boardingPasses BoardingPass[]

  @@index([organizationId])
  @@index([externalRef])
  @@index([customerId])
  @@index([document])
}

model RideRequest {
  id          String           @id @default(cuid())
  passengerId String
  passenger   PassengerProfile @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  origin      String
  destination String
  status      String           @default("REQUESTED")
  rating      Int?
  npsComment  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([passengerId, status])
  @@index([status, createdAt])
}

/// Boarding Pass dinámico corporativo (QR + token temporal) — Módulo 20
model BoardingPass {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  passengerId    String
  passenger      PassengerProfile   @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  tripId         String
  trip           Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  token          String             @unique
  qrPayload      String
  status         BoardingPassStatus @default(ISSUED)
  expiresAt      DateTime
  validatedAt    DateTime?
  validatedById  String?
  seatLabel      String?
  meta           Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([tripId, status])
  @@index([passengerId, createdAt])
  @@index([expiresAt])
}

/// Solicitud de servicio expreso / reprogramación — Portal B2B (Módulo 21)
model B2bServiceRequest {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contractId     String
  contract       TransportContract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind           B2bServiceRequestKind   @default(EXPRESS)
  status         B2bServiceRequestStatus @default(PENDING)
  origin         String
  destination    String
  requestedAt    DateTime                @default(now())
  departAt       DateTime?
  estimatedFare  Decimal?                @db.Decimal(14, 2)
  notes          String?
  rejectionReason String?
  tripId         String?
  trip           Trip?                   @relation(fields: [tripId], references: [id], onDelete: SetNull)
  originalTripId String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([customerId, status])
  @@index([contractId, status])
  @@index([tripId])
}
