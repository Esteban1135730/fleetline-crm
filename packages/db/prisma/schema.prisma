  taxIdOrDocument  String?
  issuer           String?
  amount           Decimal?                @db.Decimal(14, 2)
  issuedAt         DateTime?
  expiresAt        DateTime?
  ocrPayload       Json?
  ocrProcessedAt   DateTime?
  uploadedById     String?
  uploadedBy       User?                   @relation("ArchiveUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
