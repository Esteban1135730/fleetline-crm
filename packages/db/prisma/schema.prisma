  @@index([organizationId, severity])
}

// =============================================================================
// 8. RRHH · RECEPCIÓN/CALL · HQSE · SARLAFT · ARCHIVO · PARQUEADERO · TI
// =============================================================================

model Employee {
  id             String         @id @default(cuid())
  name           String
  document       String
  title          String
  area           String
  status         EmployeeStatus @default(ACTIVE)
  fatigueScore   Int            @default(0)
  sarlaftBlocked Boolean        @default(false)
  sarlaftRiskScore Int          @default(0)
  /// Salario base periódico (COP)
  baseSalary     Decimal        @db.Decimal(14, 2) @default(0)
  /// Tarifa hora ordinaria (COP) — overtime / nocturno
  hourlyRate     Decimal        @db.Decimal(14, 2) @default(0)
  email          String?
  phone          String?
  /// Vínculo opcional a perfil conductor (fatiga / comisiones)
  driverId       String?        @unique
  driver         Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  payrollLines PayrollLine[]

  @@unique([organizationId, document])
  @@index([organizationId, status])
  @@index([organizationId, area])
  @@index([organizationId, sarlaftBlocked])
  @@index([fatigueScore])
}

/// Turno laboral conductor — telemetría de fatiga (check-in / check-out)
model DriverShift {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  driverId         String
  driver           Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  checkInAt        DateTime
  checkOutAt       DateTime?
  status           ShiftStatus  @default(OPEN)
  continuousHours  Float?
  notes            String?
  meta             Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, driverId, checkInAt])
  @@index([driverId, status])
  @@index([organizationId, status])
}

model PayrollRun {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodStart      DateTime
  periodEnd        DateTime
  status           PayrollRunStatus @default(DRAFT)
  totalGross       Decimal          @db.Decimal(14, 2) @default(0)
  totalOvertime    Decimal          @db.Decimal(14, 2) @default(0)
  totalNight       Decimal          @db.Decimal(14, 2) @default(0)
  totalCommissions Decimal          @db.Decimal(14, 2) @default(0)
  totalNet         Decimal          @db.Decimal(14, 2) @default(0)
  calculatedAt     DateTime?
  meta             Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lines PayrollLine[]

  @@index([organizationId, periodStart, periodEnd])
  @@index([organizationId, status])
}

model PayrollLine {
  id              String     @id @default(cuid())
  payrollRunId    String
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  driverId        String?
  driver          Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  baseSalary      Decimal    @db.Decimal(14, 2) @default(0)
  ordinaryHours   Float      @default(0)
  overtimeHours   Float      @default(0)
  overtimeAmount  Decimal    @db.Decimal(14, 2) @default(0)
  nightHours      Float      @default(0)
  nightAmount     Decimal    @db.Decimal(14, 2) @default(0)
  completedTrips  Int        @default(0)
  tripCommissions Decimal    @db.Decimal(14, 2) @default(0)
  grossTotal      Decimal    @db.Decimal(14, 2) @default(0)
  meta            Json?
  createdAt       DateTime   @default(now())

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([driverId])
}

model Ticket {
  id               String          @id @default(cuid())
  code             String
  subject          String
  requester        String
  channel          TicketChannel   @default(PHONE)
  message          String
  status           TicketStatus    @default(OPEN)
  priority         TicketPriority  @default(MEDIUM)
  /// Clasificación PQRS (null = ticket helpdesk genérico)
  pqrsType         PqrsType?
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicleId        String?
  vehicle          Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId         String?
  driver           Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  /// SLA automático (horas / vencimiento)
  slaHours         Int?
  slaDueAt         DateTime?
  slaBreached      Boolean         @default(false)
  resolvedAt       DateTime?
  resolutionNotes  String?
  /// Escalamiento trazabilidad hoja de vida
  escalatedToRrhh  Boolean         @default(false)
  escalatedToHqse  Boolean         @default(false)
  assigneeId       String?
  assignee         User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meta             Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, priority, status])
  @@index([organizationId, pqrsType, status])
  @@index([customerId, status])
  @@index([assigneeId, status])
  @@index([channel, status])
  @@index([slaDueAt, status])
  @@index([driverId])
  @@index([vehicleId])
  @@index([createdAt])
}

model Visitor {
  id             String           @id @default(cuid())
  name           String
  document       String
  company        String?
  reason         String
  hostName       String
  kind           VisitorKind      @default(VISITOR)
  /// Candidato / proveedor / B2B — dispara notificaciones de área
  visitClass     VisitClass       @default(OTHER)
  boardStatus    VisitBoardStatus @default(WAITING)
  /// Gafete RFID entregado en portería
  badgeRfid      String?
  hostUserId     String?
  siteLabel      String?
  phone          String?
  /// ARL vigente requerida para contratistas
  arlValid       Boolean          @default(false)
  arlExpiresAt   DateTime?
  passCode       String?
  qrPayload      String?
  badgeIssuedAt  DateTime?
  checkedInAt    DateTime         @default(now())
  checkedOutAt   DateTime?
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meta           Json?

  @@index([organizationId, checkedOutAt])
  @@index([organizationId, boardStatus])
  @@index([organizationId, passCode])
  @@index([document])
  @@index([kind, checkedOutAt])
  @@index([visitClass, boardStatus])
}

model QualityEvent {
  id             String       @id @default(cuid())
  kind           String
  title          String
  status         String       @default("OPEN")
  npsScore       Int?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([kind, createdAt])
}

/// Incidente / accidente de tránsito o hallazgo SST (Módulo 14 HQSE)
model HqseIncident {
  id             String           @id @default(cuid())
  code           String
  kind           IncidentKind     @default(TRAFFIC_ACCIDENT)
  severity       IncidentSeverity
  status         IncidentStatus   @default(OPEN)
  title          String
  description    String?
  occurredAt     DateTime
  location       String?
  vehicleId      String?
  vehicle        Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId       String?
  driver         Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  /// OT de peritaje abierta en Taller (07)
  workOrderId    String?
  autoBlocked    Boolean          @default(false)
  reportedById   String?
  meta           Json?
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, severity, status])
  @@index([organizationId, occurredAt])
  @@index([vehicleId, severity])
  @@index([driverId, severity])
}

/// Matriz de riesgos PESV / ISO 39001
model PesvRiskControl {
