  matchedCount   Int                      @default(0)
  unmatchedCount Int                      @default(0)
  closedAt       DateTime?
  closedById     String?
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([organizationId, status])
}

/// Contador de productividad del auxiliar (jornada)
model AuxiliarProductivityLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  workDate       DateTime @db.Date
  documentsCount Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId, workDate])
  @@index([userId, workDate])
}

// =============================================================================
// 7b. TESORERÍA — PaymentSchedule (Zero-Touch) + Rodamientos
// =============================================================================

enum PaymentScheduleStatus {
  PENDING
  QUEUED
  DISBURSED
  FAILED
  CANCELLED
}

enum RodamientoLiquidationStatus {
  DRAFT
  LIQUIDATED
  PAID
  CANCELLED
}

/// Obligación de pago generada tras 3-Way Match APPROVED
model PaymentSchedule {
  id               String                @id @default(cuid())
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId        String
  invoice          Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  purchaseOrderId  String?
  threeWayMatchId  String?
  amount           Decimal               @db.Decimal(14, 2)
  currency         String                @default("COP")
  counterparty     String
  status           PaymentScheduleStatus @default(QUEUED)
  dueDate          DateTime?
  queuedAt         DateTime              @default(now())
  disbursedAt      DateTime?
  disbursedById    String?
  disbursedBy      User?                 @relation("PaymentDisburser", fields: [disbursedById], references: [id], onDelete: SetNull)
  mfaVerified      Boolean               @default(false)
  bankRef          String?
  failureReason    String?
  meta             Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([invoiceId])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([status, queuedAt])
  @@index([threeWayMatchId])
}

/// Liquidación periódica de rodamientos (conductores / propietarios)
model RodamientoLiquidation {
  id             String                      @id @default(cuid())
  organizationId String
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  periodFrom     DateTime
  periodTo       DateTime
  vehicleId      String?
  driverId       String?
  tripCount      Int                         @default(0)
  amount         Decimal                     @db.Decimal(14, 2)
  status         RodamientoLiquidationStatus @default(LIQUIDATED)
  details        Json?
  liquidatedById String?
  liquidatedBy   User?                       @relation("RodamientoLiquidator", fields: [liquidatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, periodFrom, periodTo])
  @@index([driverId])
  @@index([vehicleId])
}

model Account {
  id             String       @id @default(cuid())
  code           String
  name           String
  type           AccountType
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  debitLines  JournalLine[] @relation("DebitAccount")
  creditLines JournalLine[] @relation("CreditAccount")

  @@unique([organizationId, code])
  @@index([organizationId, type])
}

model JournalEntry {
  id             String             @id @default(cuid())
  memo           String
  status         JournalEntryStatus @default(DRAFT)
  postedAt       DateTime?
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lines JournalLine[]

  @@index([organizationId, status])
  @@index([organizationId, postedAt])
}

model JournalLine {
  id             String       @id @default(cuid())
  entryId        String
  entry          JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  debitAccountId String
  debitAccount   Account      @relation("DebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccountId String
  creditAccount  Account      @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)
  amount         Decimal      @db.Decimal(14, 2)
  /// Centro de costo por placa (ej. BOG-892)
  costCenterPlate String?

  @@index([entryId])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([costCenterPlate])
}

/// Centro de costo contable vinculado a placa / vehículo
model CostCenter {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  /// Placa canónica (ABC-123)
  plate          String
  vehicleId      String?
  name           String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, plate])
  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([vehicleId])
}

/// Timbrado DIAN — traza de emisión FE
model DianEmission {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  cufe           String
  provider       String   @default("DIAN_MOCK")
  xmlRef         String?
  pdfRef         String?
  stampedAt      DateTime @default(now())
