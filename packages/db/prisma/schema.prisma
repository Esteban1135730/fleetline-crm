/// Expediente probatorio digital inmutable (placa → PDF sellado)
model EvidentiaryPackage {
  id             String                    @id @default(cuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  plate          String
  vehicleId      String?
  tripId         String?
  contentHash    String
  pdfRef         String
  status         EvidentiaryPackageStatus  @default(GENERATED)
  sectionsJson   Json
  preopCount     Int                       @default(0)
  gpsPointCount  Int                       @default(0)
  workOrderCount Int                       @default(0)
  generatedById  String?
  sealedAt       DateTime?
  meta           Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, plate])
  @@index([contentHash])
