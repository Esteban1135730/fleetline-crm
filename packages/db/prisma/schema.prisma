  bottleneck     String?
  chatChannel    String?
  videoLink      String?
  closedAt       DateTime?
  meta           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status, createdAt])
