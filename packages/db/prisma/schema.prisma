// =============================================================================
// FLEETLINE OS — schema.prisma base (SSOT)
// Fuente de verdad: Nueva carpeta/FLEETLINE_MANUAL_GENERAL_MODULOS.pdf (21 módulos)
// Pilares: NestJS + PostgreSQL/Prisma · Kafka · Redis · RBAC Read-Only directivo
//           Compliance Gate / Kill-Switch · 3-Way Matching · CV taller
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

