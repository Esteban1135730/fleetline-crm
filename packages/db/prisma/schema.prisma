// =============================================================================
// 1. TENANT + RBAC + AUDITORÍA
// =============================================================================

/// Empresa de transporte = tenant. `id` es el `tenantId` multi-tenant.
model Organization {
  id        String   @id @default(cuid())
  name      String
  nit       String   @unique
  /// Estado licencia / operación del tenant
  status    TenantStatus @default(ACTIVE)
  /// Tope de usuarios contratados (licencias)
  maxUsers  Int      @default(50)
  suspendedAt       DateTime?
  suspendedReason   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  rolePermissions    RolePermission[]
  customers          Customer[]
  vehicles           Vehicle[]
  drivers            Driver[]
  routes             Route[]
  trips              Trip[]
  planillas          Planilla[]
  invoices           Invoice[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  employees          Employee[]
  tickets            Ticket[]
  qualityEvents      QualityEvent[]
  fuecDocuments      FuecDocument[]
  sarlaftChecks      SarlaftCheck[]
  archiveDocuments   ArchiveDocument[]
  visitors           Visitor[]
  systemAlerts       SystemAlert[]
  forensicFindings   ForensicFinding[]
  transportContracts TransportContract[]
  purchaseOrders     PurchaseOrder[]
  suppliers          Supplier[]
  inventoryItems     InventoryItem[]
  workOrders         WorkOrder[]
  complianceDocs     ComplianceDocument[]
  parkingLogs        ParkingLog[]
  yardEvents         YardEvent[]
  executiveQueries   ExecutiveQueryLog[]
  familyProfiles     FamilyProfile[]
  passengerProfiles  PassengerProfile[]
  paymentSchedules   PaymentSchedule[]
  rodamientoLiquidations RodamientoLiquidation[]
  driverShifts       DriverShift[]
  payrollRuns        PayrollRun[]
  yardAccessLogs     YardAccessLog[]
  yardInspections    YardInspection[]
  secopOpportunities SecopOpportunity[]
  hqseIncidents      HqseIncident[]
  pesvRiskControls   PesvRiskControl[]
  hqseTrainings      HqseTrainingRecord[]
  hqseDrills         HqseSafetyDrill[]
  hqseAudits         HqseAudit[]
  systemLogs         SystemLog[]
  kafkaDlqMessages   KafkaDlqMessage[]
  sttsJobs           SttsJob[]
  schoolRoutes       SchoolRoute[]
  schoolStudents     SchoolStudent[]
  schoolRouteRuns    SchoolRouteRun[]
  schoolNovelties    SchoolNovelty[]
  parentNotifications ParentNotification[]
  boardingPasses     BoardingPass[]
  b2bServiceRequests B2bServiceRequest[]
  tripAuditLogs      TripAuditLog[]
  driverNovelties    DriverNovelty[]
  payrollLaborConfigs PayrollLaborConfig[]
  tripDeviationRequests TripDeviationRequest[]
  tripChatMessages   TripChatMessage[]
  supportChatMessages SupportChatMessage[]
  tripFieldIncidents TripFieldIncident[]
  userNotifications  UserNotification[]
  webPushSubscriptions WebPushSubscription[]
  devicePushTokens   DevicePushToken[]
  systemTickets      SystemTicket[]
  tiOnboardingLinks  TiOnboardingLink[]
  tiMdmPairSessions  TiMdmPairSession[]
  stationeryItems    StationeryItem[]
  stationeryDispatches StationeryDispatch[]
  documentLoans      DocumentLoan[]
  expenseLegalizations ExpenseLegalization[]
  bankStatements     BankStatement[]
  bankReconciliations BankReconciliation[]
  costCenters        CostCenter[]
  routeExpenses      RouteExpense[]
  dianEmissions      DianEmission[]

  @@index([nit])
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  /// Rol primario (compat UI). Permisos finos viven en RolePermission.
  role           RoleCode     @default(DESPACHO)
  /// Vista directiva: fuerza AccessLevel.READ_ONLY en dominios operativos.
  directiveReadOnly Boolean   @default(false)
  /// PENDING = espera autorización de mando superior / org admin
  status         UserAccountStatus @default(ACTIVE)
  approvedById   String?
  approvedBy     User?        @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvalsGiven User[]       @relation("UserApprovals")
  approvedAt     DateTime?
  active         Boolean      @default(true)
  lastLoginAt    DateTime?
  lastIp         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  auditLogs          AuditLog[]
  workOrders         WorkOrder[]          @relation("AssignedMechanic")
  tickets            Ticket[]             @relation("TicketAssignee")
  driverProfile      Driver?
  monitorProfile     MonitorProfile?
  approvedPayments   Invoice[]            @relation("InvoicePaymentApprover")
  archiveUploads     ArchiveDocument[]    @relation("ArchiveUploader")
  purchaseApprovals  PurchaseOrder[]      @relation("PurchaseApprover")
  goodsReceipts      GoodsReceipt[]       @relation("GoodsReceiptReceiver")
  partDispatches     PartDispatch[]       @relation("PartDispatcher")
  executiveQueries   ExecutiveQueryLog[]
  systemTickets      SystemTicket[]
  disbursedPayments  PaymentSchedule[]    @relation("PaymentDisburser")
  rodamientoLiquidations RodamientoLiquidation[] @relation("RodamientoLiquidator")
  sarlaftResolutions SarlaftCheck[] @relation("SarlaftResolver")
  notifications      UserNotification[]
  webPushSubscriptions WebPushSubscription[]
  devicePushTokens   DevicePushToken[]

  @@index([organizationId, role])
  @@index([organizationId, active])
  @@index([organizationId, status])
  @@index([organizationId, directiveReadOnly])
}

/// Matriz RBAC: rol × módulo × nivel (Presidencia operativa = READ_ONLY)
model RolePermission {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           RoleCode
  module         FleetModule
  access         AccessLevel  @default(NONE)
  /// Si true, el rol solo puede consultar (nunca mutar) aunque access diga otra cosa
  forceReadOnly  Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, role, module])
  @@index([organizationId, role])
  @@index([module, access])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  action         String
  entity         String
  entityId       String?
  module         FleetModule?
  meta           Json?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@index([module, createdAt])
  @@index([userId, createdAt])
}

/// Log de Text-to-SQL / RAG directivo (Presidencia / Gerencia)
model ExecutiveQueryLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  utterance      String
  generatedSql   String?
  answerText     String?
  ttsAudioRef    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

// =============================================================================
// 2. FLOTA — VEHÍCULOS, CONDUCTORES Y COMPLIANCE (SOAT / RUNT / LICENCIAS)
//     Kill-Switch: complianceBlocked / nightRestricted bloquean despacho
// =============================================================================

model Vehicle {
  id                   String        @id @default(cuid())
  plate                String
  brand                String
  model                String
  year                 Int
  vin                  String?
  capacity             Int           @default(20)
  status               VehicleStatus @default(AVAILABLE)
  lat                  Float         @default(4.711)
  lng                  Float         @default(-74.0721)
  odometerKm           Int           @default(0)
  maintenanceEveryKm   Int           @default(10000)
  /// Hard-Stop operativo (SOAT/FUEC/licencias vencidas, Kafka tramites.vehiculo.suspendido)
  complianceBlocked    Boolean       @default(false)
  complianceReason     String?
  /// Kill-Switch nocturno / restricción horaria
  nightRestricted      Boolean       @default(false)
  soatActivo           Boolean       @default(false)
  tecnoActiva          Boolean       @default(false)
  organizationId       String
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  trips            Trip[]
  planillas        Planilla[]
  workOrders       WorkOrder[]
  fuecDocuments    FuecDocument[]
  complianceDocs   ComplianceDocument[]
  parkingLogs      ParkingLog[]
  yardEvents       YardEvent[]
  yardAccessLogs   YardAccessLog[]
  yardInspections  YardInspection[]
  gpsSnapshots     GpsSnapshot[]
  archiveDocuments ArchiveDocument[]
  hqseIncidents    HqseIncident[]
  pqrsTickets      Ticket[]
  schoolRoutes     SchoolRoute[]

  @@unique([organizationId, plate])
  @@index([organizationId, status])
  @@index([organizationId, complianceBlocked])
  @@index([organizationId, soatActivo, tecnoActiva])
  @@index([status, complianceBlocked])
}

model Driver {
  id               String       @id @default(cuid())
  name             String
  document         String
  phone            String?
  licenseNumber    String?
  licenseExpiresAt DateTime?
  licenseCategory  String?
  active           Boolean      @default(true)
  fatigueScore     Int          @default(0)
  /// Bloqueo por licencia vencida / fatiga / RRHH
  dispatchBlocked  Boolean      @default(false)
  blockReason      String?
  userId           String?      @unique
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  trips          Trip[]
  planillas      Planilla[]
  complianceDocs ComplianceDocument[]
  preops         Preoperational[]
  shifts         DriverShift[]
  payrollLines   PayrollLine[]
  employee       Employee?
  parkingLogs    ParkingLog[]
  yardAccessLogs YardAccessLog[]
  archiveDocuments ArchiveDocument[]
  hqseIncidents    HqseIncident[]
  hqseTrainings    HqseTrainingRecord[]
  pqrsTickets      Ticket[]
  schoolRoutes     SchoolRoute[]
  novelties        DriverNovelty[]

  @@unique([organizationId, document])
  @@index([organizationId, active])
  @@index([organizationId, dispatchBlocked])
  @@index([licenseExpiresAt])
  @@index([fatigueScore])
}

/// Documentos de compliance (vehículo o conductor) — SOAT, RUNT, licencias, etc.
model ComplianceDocument {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type             ComplianceDocType
  status           DocStatus         @default(PENDING)
  reference        String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  /// Hash OCR / archivo sellado
  contentHash      String?
  fileRef          String?
  /// Resultado validación RUNT / Fasecolda / Document AI
  runtVerified     Boolean           @default(false)
  runtPayload      Json?
  ocrPayload       Json?
  vehicleId        String?
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId         String?
  driver           Driver?           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId, type, status])
  @@index([organizationId, expiresAt])
  @@index([vehicleId, type, status])
  @@index([driverId, type, status])
  @@index([status, expiresAt])
  @@index([contentHash])
}

// =============================================================================
// 3. LOGÍSTICA — RUTAS, VIAJES, PLANILLAS / FUEC, PREOPERACIONAL, GPS
// =============================================================================

model Route {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  origin         String
  destination    String
  polyline       String?
  distanceKm     Float?
  etaMinutes     Int?
  active         Boolean      @default(true)
  meta           Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  trips     Trip[]
  planillas Planilla[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model Trip {
  id             String       @id @default(cuid())
  code           String
  origin         String
  destination    String
  departAt       DateTime
  /// Fin programado del servicio
  arriveAt       DateTime?
  /// Inicio / fin reales (reloj servidor)
  startedAt      DateTime?
  completedAt    DateTime?
  status         TripStatus   @default(PENDING)
  fareAmount     Decimal      @db.Decimal(14, 2)
  distanceKm     Float?
  incidentNote   String?
  /// Cliente / funcionario beneficiario del servicio
  officerName    String?
  officerDocument String?
  suggestedPolyline String?
  originLat      Float?
  originLng      Float?
  destLat        Float?
  destLng        Float?
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contractId     String?
  contract       TransportContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId       String?
  driver         Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  routeId        String?
  route          Route?       @relation(fields: [routeId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  planilla       Planilla?
  preoperational Preoperational?
  routeExpenses  RouteExpense[]
  invoices       Invoice[]
  boardingPasses BoardingPass[]
  b2bRequests    B2bServiceRequest[]
  auditLogs      TripAuditLog[]
  trackPoints    TripTrackPoint[]
  overtimeLines  TripOvertimeLine[]
  deviationRequests TripDeviationRequest[]
  chatMessages   TripChatMessage[]
  fieldIncidents TripFieldIncident[]

  @@unique([code])
  @@index([organizationId, status])
  @@index([organizationId, departAt])
  @@index([vehicleId, status])
  @@index([driverId, status])
  @@index([customerId])
  @@index([status, departAt])
}

/// Auditoría inmutable vinculada al servicio
model TripAuditLog {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tripId         String
  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  action         TripAuditAction
  message        String
  meta           Json?
  actorUserId    String?
  serverTime     DateTime        @default(now())
  createdAt      DateTime        @default(now())

  @@index([tripId, createdAt])
  @@index([organizationId, createdAt])
}

/// Histórico GPS por servicio (App conductor → uplink)
model TripTrackPoint {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicleId  String?
  lat        Float
  lng        Float
  speedKph   Float?
  heading    Float?
  recordedAt DateTime @default(now())

  @@index([tripId, recordedAt])
  @@index([vehicleId, recordedAt])
}

/// Solicitud de inicio/fin fuera de tolerancia (geofence / horario) — aprobación supervisor
model TripDeviationRequest {
  id               String              @id @default(cuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tripId           String
  trip             Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  action           TripDeviationAction
  status           TripDeviationStatus @default(PENDING)
  /// Estado del viaje antes de la solicitud (para restaurar si se rechaza)
  previousStatus   TripStatus
  reasonCodes      String[]
  reasonDetail     String
  lat              Float
  lng              Float
  distanceM        Float?
  serverTime       DateTime            @default(now())
  scheduledAt      DateTime?
  requestedById    String?
  resolvedById     String?
  resolvedAt       DateTime?
  resolveNote      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([tripId, status])
}

/// Chat in-app por viaje (conductor ↔ supervisor)
model TripChatMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tripId         String
  trip           Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  authorUserId   String
  authorName     String
  authorRole     String
  body           String
  serverTime     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([tripId, createdAt])
  @@index([organizationId, createdAt])
}

/// Chat general de soporte técnico (app multi-rol)
model SupportChatMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorUserId   String
  authorName     String
  authorRole     String
  body           String
  serverTime     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

/// Incidente / retraso de campo — NO bloquea el viaje ni el GPS
model TripFieldIncident {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tripId         String
  trip           Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category       TripIncidentCategory
  notes          String?
  photoUrl       String?
  lat            Float?
  lng            Float?
  reportedById   String?
  serverTime     DateTime             @default(now())
  createdAt      DateTime             @default(now())

  @@index([tripId, createdAt])
  @@index([organizationId, createdAt])
}

/// Novedades de disponibilidad / calendario conductor
model DriverNovelty {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  driverId       String
  driver         Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  kind           DriverNoveltyKind
  dateFrom       DateTime
  dateTo         DateTime
  notes          String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, driverId, dateFrom])
  @@index([driverId, dateFrom, dateTo])
  @@index([kind, dateFrom])
}

/// Parámetros liquidación horas extras (Excel Proyecto CRM)
model PayrollLaborConfig {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  baseSalary           Decimal      @db.Decimal(14, 2) @default(1423500)
  monthlyHoursDivisor  Float        @default(230)
  weeklyOrdinaryHours  Float        @default(42)
  rnFactor             Float        @default(0.35)
  hedFactor            Float        @default(1.25)
  henFactor            Float        @default(1.75)
  rodFestFactor        Float        @default(1.75)
  hedfFactor           Float        @default(2.0)
  henfFactor           Float        @default(2.5)
  rnfFactor            Float        @default(1.1)
  updatedAt            DateTime     @updatedAt
  createdAt            DateTime     @default(now())
}

/// Pre-nómina de extras por servicio cerrado (fuente del reporte mensual /nomina)
model TripOvertimeLine {
  id             String   @id @default(cuid())
  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driverId       String
  workDate       DateTime
  ordinaryHours  Float    @default(0)
  rnHours        Float    @default(0)
  hedHours       Float    @default(0)
  henHours       Float    @default(0)
  rodFestHours   Float    @default(0)
  hedfHours      Float    @default(0)
  henfHours      Float    @default(0)
  rnfHours       Float    @default(0)
  hourlyRate     Decimal  @db.Decimal(14, 4)
  rnAmount       Decimal  @db.Decimal(14, 2) @default(0)
  hedAmount      Decimal  @db.Decimal(14, 2) @default(0)
  henAmount      Decimal  @db.Decimal(14, 2) @default(0)
  rodFestAmount  Decimal  @db.Decimal(14, 2) @default(0)
  hedfAmount     Decimal  @db.Decimal(14, 2) @default(0)
  henfAmount     Decimal  @db.Decimal(14, 2) @default(0)
  rnfAmount      Decimal  @db.Decimal(14, 2) @default(0)
  totalAmount    Decimal  @db.Decimal(14, 2) @default(0)
  breakdown      Json?
  createdAt      DateTime @default(now())

  @@unique([tripId])
  @@index([driverId, workDate])
}

/// Planilla operativa liberada tras Compliance Gate (preop + FUEC)
model Planilla {
  id             String         @id @default(cuid())
  code           String
  status         PlanillaStatus @default(DRAFT)
  fuecHash       String?
  rutaSugerida   String?
  releasedAt     DateTime?
  startedAt      DateTime?
  closedAt       DateTime?
  tripId         String         @unique
  trip           Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driverId       String
  driver         Driver         @relation(fields: [driverId], references: [id], onDelete: Restrict)
  routeId        String?
  route          Route?         @relation(fields: [routeId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  fuec FuecDocument?

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([vehicleId, status])
  @@index([driverId, status])
  @@index([status, startedAt])
}

model Preoperational {
  id             String   @id @default(cuid())
  tripId         String   @unique
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driverId       String
  driver         Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  brakesOk       Boolean
  lightsOk       Boolean
  tiresOk        Boolean
  kitOk          Boolean
  oilOk          Boolean
  observations   String?
  approved       Boolean  @default(false)
  signedAt       DateTime @default(now())
  payload        Json?

  @@index([driverId, signedAt])
  @@index([approved, signedAt])
}

model FuecDocument {
  id               String       @id @default(cuid())
  number           String
  contractorName   String
  routeLabel       String
  validFrom        DateTime
  validTo          DateTime
  status           DocStatus    @default(PENDING)
  cryptoHash       String?
  qrPayload        String?
  pdfUrl           String?
  vehicleId        String?
  vehicle          Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  planillaId       String?      @unique
  planilla         Planilla?    @relation(fields: [planillaId], references: [id], onDelete: SetNull)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([vehicleId, status])
  @@index([validTo, status])
  @@index([cryptoHash])
}

/// Snapshot persistido (Redis es caché en vivo; esto es histórico / auditoría)
model GpsSnapshot {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  speedKph  Float?
  heading   Float?
  recordedAt DateTime @default(now())

  @@index([vehicleId, recordedAt])
  @@index([recordedAt])
}

enum RouteExpenseKind {
  PEAJE
  TANQUEO
  COMBUSTIBLE
  OTRO
}

enum RouteExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  POSTED
}

/// Smart Wallet / gastos de ruta — peajes, tanqueos (OCR + auditoría contable)
model RouteExpense {
  id             String             @id @default(cuid())
  organizationId String?
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tripId         String?
  trip           Trip?              @relation(fields: [tripId], references: [id], onDelete: SetNull)
  plate          String?
  vehicleId      String?
  driverId       String?
  driverName     String?
  kind           String // PEAJE | TANQUEO | COMBUSTIBLE | OTRO
  amount         Decimal            @db.Decimal(14, 2)
  gallons        Float?
  station        String?
  ocrPayload     Json?
  fileRef        String?
  photoRef       String?
  aiExtracted    Json?
  status         RouteExpenseStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  journalEntryId String?
  rejectReason   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt

  @@index([tripId, kind])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, plate])
  @@index([vehicleId])
  @@index([createdAt])
}

// =============================================================================
// 4. TALLER — OT, REPUESTOS, DESPACHO QR + EVIDENCIA CV
// =============================================================================

model WorkOrder {
  id               String          @id @default(cuid())
  code             String
  description      String
  status           WorkOrderStatus @default(OPEN)
  odometerAtOpen   Int?
  vehicleId        String
  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignedToId     String?
  assignedTo       User?           @relation("AssignedMechanic", fields: [assignedToId], references: [id], onDelete: SetNull)
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  openedAt         DateTime        @default(now())
  closedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  requiredParts WorkOrderPart[]
  dispatches    PartDispatch[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([vehicleId, status])
  @@index([assignedToId, status])
  @@index([status, openedAt])
}

model InventoryItem {
  id             String              @id @default(cuid())
  sku            String
  serial         String?
  name           String
  qrCode         String              @unique
  quantity       Int                 @default(0)
  minStock       Int                 @default(1)
  unitCost       Decimal             @db.Decimal(14, 2) @default(0)
  status         InventoryItemStatus @default(AVAILABLE)
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  workOrderParts WorkOrderPart[]
  dispatches     PartDispatch[]
  poLines        PurchaseOrderLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, serial])
  @@index([organizationId, status])
  @@index([organizationId, quantity])
  @@index([supplierId])
}

model WorkOrderPart {
  id              String        @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Int           @default(1)

  @@unique([workOrderId, inventoryItemId])
  @@index([inventoryItemId])
}

model PartDispatch {
  id                 String        @id @default(cuid())
  workOrderId        String
  workOrder          WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItemId    String
  inventoryItem      InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  dispatchedById     String
  dispatchedBy       User          @relation("PartDispatcher", fields: [dispatchedById], references: [id], onDelete: Restrict)
  mechanicQrScanned  String?
  partQrScanned      String?
  /// Evidencia CV antifraude
  photoOldRef        String?
  photoNewRef        String?
  cvValidationOk     Boolean?
  cvPayload          Json?
  dispatchedAt       DateTime      @default(now())

  @@index([workOrderId, dispatchedAt])
  @@index([inventoryItemId])
  @@index([dispatchedById, dispatchedAt])
}

// =============================================================================
// 5. COMPRAS — OC, REMISIÓN, FACTURA PROVEEDOR, 3-WAY MATCHING
// =============================================================================

model Supplier {
  id             String       @id @default(cuid())
  name           String
  nit            String
  email          String?
  phone          String?
  active         Boolean      @default(true)
  /// Bloqueo AML / listas restrictivas (Módulo 15)
  sarlaftBlocked Boolean      @default(false)
  sarlaftRiskScore Int        @default(0)
  /// SKUs / categorías que ofrece (smart bidding)
  productTags    String[]
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchaseOrders PurchaseOrder[]
  inventoryItems InventoryItem[]
  invoices       Invoice[]
  archiveDocuments ArchiveDocument[]

  @@unique([organizationId, nit])
  @@index([organizationId, active])
  @@index([organizationId, sarlaftBlocked])
}

model PurchaseOrder {
  id              String         @id @default(cuid())
  code            String
  description     String?
  status          PurchaseStatus @default(DRAFT)
  totalEstimated  Decimal        @db.Decimal(14, 2) @default(0)
  currency        String         @default("COP")
  matchStatus     ThreeWayMatchStatus @default(PENDING)
  matchNotes      String?
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  approvedById    String?
  approvedBy      User?          @relation("PurchaseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lines          PurchaseOrderLine[]
  goodsReceipts  GoodsReceipt[]
  supplierInvoices Invoice[]
  matchRecords   ThreeWayMatch[]
  archiveDocuments ArchiveDocument[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, matchStatus])
  @@index([supplierId, status])
  @@index([status, createdAt])
}

model PurchaseOrderLine {
  id              String         @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  description     String
  quantity        Int
  unitCost        Decimal        @db.Decimal(14, 2)
  lineTotal       Decimal        @db.Decimal(14, 2)

  @@index([purchaseOrderId])
  @@index([inventoryItemId])
}

/// Remisión de entrada (almacén) — pata 2 del 3-Way Matching
model GoodsReceipt {
  id              String        @id @default(cuid())
  code            String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedById    String
  receivedBy      User          @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt      DateTime      @default(now())
  quantityTotal   Int
  notes           String?
  payload         Json?

  matchRecords ThreeWayMatch[]

  @@unique([code])
  @@index([purchaseOrderId, receivedAt])
  @@index([receivedById])
}

/// Resultado del cruce OC + Remisión + Factura proveedor
model ThreeWayMatch {
  id               String              @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  goodsReceiptId   String?
  goodsReceipt     GoodsReceipt?       @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  invoiceId        String?
  invoice          Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  status           ThreeWayMatchStatus @default(PENDING)
  priceDelta       Decimal             @db.Decimal(14, 2) @default(0)
  qtyDelta         Int                 @default(0)
  details          Json?
  evaluatedAt      DateTime            @default(now())

  @@index([purchaseOrderId, status])
  @@index([status, evaluatedAt])
  @@index([invoiceId])
}

// =============================================================================
// 6. COMERCIAL — CLIENTES, COTIZACIONES, CONTRATOS
// =============================================================================

model Customer {
  id             String          @id @default(cuid())
  name           String
  nit            String
  email          String?
  phone          String?
  segment        CustomerSegment @default(B2B)
  sarlaftBlocked Boolean         @default(false)
  sarlaftRiskScore Int           @default(0)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  quotes        Quote[]
  trips         Trip[]
  invoices      Invoice[]
  sarlaftChecks SarlaftCheck[]
  contracts     TransportContract[]
  familyLinks   FamilyProfile[]
  pqrsTickets   Ticket[]
  passengers    PassengerProfile[]
  b2bRequests   B2bServiceRequest[]

  @@unique([organizationId, nit])
  @@index([organizationId, segment])
  @@index([organizationId, sarlaftBlocked])
  @@index([name])
}

model Quote {
  id         String      @id @default(cuid())
  code       String
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Decimal     @db.Decimal(14, 2)
  currency   String      @default("COP")
  status     QuoteStatus @default(DRAFT)
  notes      String?
  calcJson   Json?
  secopRef   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([code])
  @@index([customerId, status])
  @@index([status, createdAt])
}

model TransportContract {
  id                 String            @id @default(cuid())
  code               String
  name               String
  channel            CommercialChannel @default(PRIVATE)
  routeLabel         String
  monthlyValue       Decimal           @db.Decimal(14, 2)
  /// Presupuesto total contratado (COP)
  budgetCap          Decimal?          @db.Decimal(14, 2)
  budgetConsumed     Decimal           @db.Decimal(14, 2) @default(0)
  /// Cupo de viajes / vehículos
  tripQuota          Int?
  tripsUsed          Int               @default(0)
  vehicleQuota       Int?
  vehiclesAllocated  Int               @default(0)
  rateType           ContractRateType  @default(FIXED)
  fixedFare          Decimal?          @db.Decimal(14, 2)
  ratePerKm          Decimal?          @db.Decimal(14, 2)
  secopProcessId     String?
  startsAt           DateTime
  endsAt             DateTime?
  status             ContractStatus    @default(DRAFT)
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  trips Trip[]
  b2bRequests B2bServiceRequest[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([customerId, status])
  @@index([secopProcessId])
  @@index([endsAt])
}

/// Snapshot local de oportunidades SECOP II (B2G)
model SecopOpportunity {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processId        String
  title            String
  entityName       String
  modality         String
  status           String       @default("OPEN")
  category         String
  estimatedValue   Decimal?     @db.Decimal(14, 2)
  publishAt        DateTime?
  closeAt          DateTime?
  url              String?
  rawPayload       Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, processId])
  @@index([organizationId, status, closeAt])
  @@index([category, status])
}

// =============================================================================
// 7. TESORERÍA / CONTABILIDAD / REVISORÍA
// =============================================================================

model Invoice {
  id                 String        @id @default(cuid())
  number             String
  type               InvoiceType
  status             InvoiceStatus @default(DRAFT)
  counterparty       String
  amount             Decimal       @db.Decimal(14, 2)
  dueDate            DateTime?
  paidAt             DateTime?
  xmlHash            String?
  dianPayload        Json?
  paymentApproved    Boolean       @default(false)
  paymentApprovedAt  DateTime?
  paymentApprovedById String?
  paymentApprovedBy  User?         @relation("InvoicePaymentApprover", fields: [paymentApprovedById], references: [id], onDelete: SetNull)
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId         String?
  supplier           Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  tripId             String?
  trip               Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  threeWayMatches ThreeWayMatch[]
  paymentSchedules PaymentSchedule[]
  /// Prefactura / anexo B2B
  prefacturaAnnex  Json?
  dianCufe         String?
  dianStampedAt    DateTime?
  dianXmlRef       String?
  dianPdfRef       String?

  @@unique([organizationId, number])
  @@index([organizationId, type, status])
  @@index([organizationId, dueDate])
  @@index([purchaseOrderId])
  @@index([tripId])
  @@index([xmlHash])
  @@index([status, dueDate])
  @@index([dianCufe])
}

enum ExpenseLegalizationStatus {
  OPEN
  IN_REVIEW
  CLOSED
  ADJUSTED_PAYROLL
  REFUND_PENDING
}

/// Legalización de viáticos / caja menor (conductores) — Módulo 4.1
model ExpenseLegalization {
  id               String                     @id @default(cuid())
  organizationId   String
  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  driverId         String?
  driverUserId     String?
  driverName       String?
  advanceAmount    Decimal                    @db.Decimal(14, 2) @default(0)
  expensesTotal    Decimal                    @db.Decimal(14, 2) @default(0)
  balance          Decimal                    @db.Decimal(14, 2) @default(0)
  /// COMPANY_CREDIT | DRIVER_CREDIT | ZERO
  settlementKind   String?
  status           ExpenseLegalizationStatus  @default(OPEN)
  supportFileRef   String?
  notes            String?
  reviewedById     String?
  closedAt         DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  lines            ExpenseLegalizationLine[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([driverId])
}

model ExpenseLegalizationLine {
  id               String              @id @default(cuid())
  legalizationId   String
  legalization     ExpenseLegalization @relation(fields: [legalizationId], references: [id], onDelete: Cascade)
  source           String              @default("SMART_WALLET") // SMART_WALLET | MANUAL
  description      String
  amount           Decimal             @db.Decimal(14, 2)
  receiptRef       String?
  spentAt          DateTime?
  createdAt        DateTime            @default(now())

  @@index([legalizationId])
