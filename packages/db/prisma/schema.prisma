  @@index([organizationId, docType])
  @@index([organizationId, validationStatus])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, pendingDigitization])
  @@index([organizationId, custodyStatus])
  @@index([vehicleId])
  @@index([driverId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([contentHash])
  @@index([title])
  @@index([plate])
  @@index([taxIdOrDocument])
  @@index([deletedAt])
