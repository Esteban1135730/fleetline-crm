  status           String       @default("PENDING") // PENDING | SENT | ACK | FAILED | REJECTED
  requestedById    String
  confirmedProtocol Boolean     @default(false)
  payload          Json?
  transmittedAt    DateTime?
  ackAt            DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, command, createdAt])
  @@index([sosSessionId])
  @@index([vehicleId, createdAt])
}

