// =============================================================================
// 1. TENANT + RBAC + AUDITORÍA
// =============================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  nit       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  rolePermissions    RolePermission[]
  customers          Customer[]
  vehicles           Vehicle[]
  drivers            Driver[]
  routes             Route[]
  trips              Trip[]
  planillas          Planilla[]
  invoices           Invoice[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  employees          Employee[]
  tickets            Ticket[]
  qualityEvents      QualityEvent[]
  fuecDocuments      FuecDocument[]
  sarlaftChecks      SarlaftCheck[]
  archiveDocuments   ArchiveDocument[]
  visitors           Visitor[]
  systemAlerts       SystemAlert[]
  forensicFindings   ForensicFinding[]
  transportContracts TransportContract[]
  purchaseOrders     PurchaseOrder[]
  suppliers          Supplier[]
  inventoryItems     InventoryItem[]
  workOrders         WorkOrder[]
  complianceDocs     ComplianceDocument[]
  parkingLogs        ParkingLog[]
  yardEvents         YardEvent[]
  executiveQueries   ExecutiveQueryLog[]
  familyProfiles     FamilyProfile[]
  passengerProfiles  PassengerProfile[]
  paymentSchedules   PaymentSchedule[]
  rodamientoLiquidations RodamientoLiquidation[]
  driverShifts       DriverShift[]
  payrollRuns        PayrollRun[]
  yardAccessLogs     YardAccessLog[]
  yardInspections    YardInspection[]
  secopOpportunities SecopOpportunity[]
  hqseIncidents      HqseIncident[]
  pesvRiskControls   PesvRiskControl[]
  hqseTrainings      HqseTrainingRecord[]
  hqseDrills         HqseSafetyDrill[]
  hqseAudits         HqseAudit[]
  systemLogs         SystemLog[]
  kafkaDlqMessages   KafkaDlqMessage[]
  sttsJobs           SttsJob[]
  schoolRoutes       SchoolRoute[]
  schoolStudents     SchoolStudent[]
  schoolRouteRuns    SchoolRouteRun[]
  schoolNovelties    SchoolNovelty[]
  parentNotifications ParentNotification[]
  boardingPasses     BoardingPass[]
  b2bServiceRequests B2bServiceRequest[]

  @@index([nit])
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  /// Rol primario (compat UI). Permisos finos viven en RolePermission.
  role           RoleCode     @default(DESPACHO)
  /// Vista directiva: fuerza AccessLevel.READ_ONLY en dominios operativos.
  directiveReadOnly Boolean   @default(false)
  active         Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  auditLogs          AuditLog[]
  workOrders         WorkOrder[]          @relation("AssignedMechanic")
  tickets            Ticket[]             @relation("TicketAssignee")
  driverProfile      Driver?
  monitorProfile     MonitorProfile?
  approvedPayments   Invoice[]            @relation("InvoicePaymentApprover")
  archiveUploads     ArchiveDocument[]    @relation("ArchiveUploader")
  purchaseApprovals  PurchaseOrder[]      @relation("PurchaseApprover")
  goodsReceipts      GoodsReceipt[]       @relation("GoodsReceiptReceiver")
  partDispatches     PartDispatch[]       @relation("PartDispatcher")
  executiveQueries   ExecutiveQueryLog[]
  systemTickets      SystemTicket[]
  disbursedPayments  PaymentSchedule[]    @relation("PaymentDisburser")
  rodamientoLiquidations RodamientoLiquidation[] @relation("RodamientoLiquidator")
  sarlaftResolutions SarlaftCheck[] @relation("SarlaftResolver")

  @@index([organizationId, role])
  @@index([organizationId, active])
  @@index([organizationId, directiveReadOnly])
}

/// Matriz RBAC: rol × módulo × nivel (Presidencia operativa = READ_ONLY)
model RolePermission {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           RoleCode
  module         FleetModule
  access         AccessLevel  @default(NONE)
  /// Si true, el rol solo puede consultar (nunca mutar) aunque access diga otra cosa
  forceReadOnly  Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, role, module])
  @@index([organizationId, role])
  @@index([module, access])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  action         String
  entity         String
  entityId       String?
  module         FleetModule?
  meta           Json?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@index([module, createdAt])
  @@index([userId, createdAt])
}

/// Log de Text-to-SQL / RAG directivo (Presidencia / Gerencia)
model ExecutiveQueryLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  utterance      String
  generatedSql   String?
  answerText     String?
  ttsAudioRef    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

// =============================================================================
// 2. FLOTA — VEHÍCULOS, CONDUCTORES Y COMPLIANCE (SOAT / RUNT / LICENCIAS)
//     Kill-Switch: complianceBlocked / nightRestricted bloquean despacho
// =============================================================================

model Vehicle {
  id                   String        @id @default(cuid())
  plate                String
  brand                String
  model                String
  year                 Int
  vin                  String?
  capacity             Int           @default(20)
  status               VehicleStatus @default(AVAILABLE)
  lat                  Float         @default(4.711)
  lng                  Float         @default(-74.0721)
  odometerKm           Int           @default(0)
  maintenanceEveryKm   Int           @default(10000)
  /// Hard-Stop operativo (SOAT/FUEC/licencias vencidas, Kafka tramites.vehiculo.suspendido)
  complianceBlocked    Boolean       @default(false)
  complianceReason     String?
  /// Kill-Switch nocturno / restricción horaria
  nightRestricted      Boolean       @default(false)
  soatActivo           Boolean       @default(false)
  tecnoActiva          Boolean       @default(false)
  organizationId       String
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  trips            Trip[]
  planillas        Planilla[]
  workOrders       WorkOrder[]
  fuecDocuments    FuecDocument[]
  complianceDocs   ComplianceDocument[]
  parkingLogs      ParkingLog[]
  yardEvents       YardEvent[]
  yardAccessLogs   YardAccessLog[]
  yardInspections  YardInspection[]
  gpsSnapshots     GpsSnapshot[]
  archiveDocuments ArchiveDocument[]
  hqseIncidents    HqseIncident[]
  pqrsTickets      Ticket[]
  schoolRoutes     SchoolRoute[]

  @@unique([organizationId, plate])
  @@index([organizationId, status])
  @@index([organizationId, complianceBlocked])
  @@index([organizationId, soatActivo, tecnoActiva])
  @@index([status, complianceBlocked])
}

model Driver {
  id               String       @id @default(cuid())
  name             String
  document         String
  phone            String?
  licenseNumber    String?
  licenseExpiresAt DateTime?
  licenseCategory  String?
  active           Boolean      @default(true)
  fatigueScore     Int          @default(0)
  /// Bloqueo por licencia vencida / fatiga / RRHH
  dispatchBlocked  Boolean      @default(false)
  blockReason      String?
  userId           String?      @unique
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  trips          Trip[]
  planillas      Planilla[]
  complianceDocs ComplianceDocument[]
  preops         Preoperational[]
  shifts         DriverShift[]
  payrollLines   PayrollLine[]
  employee       Employee?
  parkingLogs    ParkingLog[]
  yardAccessLogs YardAccessLog[]
  archiveDocuments ArchiveDocument[]
  hqseIncidents    HqseIncident[]
  hqseTrainings    HqseTrainingRecord[]
  pqrsTickets      Ticket[]
  schoolRoutes     SchoolRoute[]

  @@unique([organizationId, document])
  @@index([organizationId, active])
  @@index([organizationId, dispatchBlocked])
  @@index([licenseExpiresAt])
  @@index([fatigueScore])
}

/// Documentos de compliance (vehículo o conductor) — SOAT, RUNT, licencias, etc.
model ComplianceDocument {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type             ComplianceDocType
  status           DocStatus         @default(PENDING)
  reference        String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  /// Hash OCR / archivo sellado
  contentHash      String?
  fileRef          String?
  /// Resultado validación RUNT / Fasecolda / Document AI
  runtVerified     Boolean           @default(false)
  runtPayload      Json?
  ocrPayload       Json?
  vehicleId        String?
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId         String?
  driver           Driver?           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId, type, status])
  @@index([organizationId, expiresAt])
  @@index([vehicleId, type, status])
  @@index([driverId, type, status])
  @@index([status, expiresAt])
  @@index([contentHash])
}

// =============================================================================
// 3. LOGÍSTICA — RUTAS, VIAJES, PLANILLAS / FUEC, PREOPERACIONAL, GPS
// =============================================================================

model Route {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  origin         String
  destination    String
  polyline       String?
  distanceKm     Float?
  etaMinutes     Int?
  active         Boolean      @default(true)
  meta           Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  trips     Trip[]
  planillas Planilla[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model Trip {
  id             String       @id @default(cuid())
  code           String
  origin         String
  destination    String
  departAt       DateTime
  status         TripStatus   @default(PENDING)
  fareAmount     Decimal      @db.Decimal(14, 2)
  distanceKm     Float?
  incidentNote   String?
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contractId     String?
  contract       TransportContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId       String?
  driver         Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  routeId        String?
  route          Route?       @relation(fields: [routeId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  planilla       Planilla?
  preoperational Preoperational?
  routeExpenses  RouteExpense[]
  invoices       Invoice[]
  boardingPasses BoardingPass[]
  b2bRequests    B2bServiceRequest[]

  @@unique([code])
  @@index([organizationId, status])
  @@index([organizationId, departAt])
  @@index([vehicleId, status])
  @@index([driverId, status])
  @@index([customerId])
  @@index([status, departAt])
}

/// Planilla operativa liberada tras Compliance Gate (preop + FUEC)
model Planilla {
  id             String         @id @default(cuid())
  code           String
  status         PlanillaStatus @default(DRAFT)
  fuecHash       String?
  rutaSugerida   String?
  releasedAt     DateTime?
  startedAt      DateTime?
  closedAt       DateTime?
  tripId         String         @unique
  trip           Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driverId       String
  driver         Driver         @relation(fields: [driverId], references: [id], onDelete: Restrict)
  routeId        String?
  route          Route?         @relation(fields: [routeId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  fuec FuecDocument?

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([vehicleId, status])
  @@index([driverId, status])
  @@index([status, startedAt])
}

model Preoperational {
  id             String   @id @default(cuid())
  tripId         String   @unique
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driverId       String
  driver         Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  brakesOk       Boolean
  lightsOk       Boolean
  tiresOk        Boolean
  kitOk          Boolean
  oilOk          Boolean
  observations   String?
  approved       Boolean  @default(false)
  signedAt       DateTime @default(now())
  payload        Json?

  @@index([driverId, signedAt])
  @@index([approved, signedAt])
}

model FuecDocument {
  id               String       @id @default(cuid())
  number           String
  contractorName   String
  routeLabel       String
  validFrom        DateTime
  validTo          DateTime
  status           DocStatus    @default(PENDING)
  cryptoHash       String?
  qrPayload        String?
  pdfUrl           String?
  vehicleId        String?
  vehicle          Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  planillaId       String?      @unique
  planilla         Planilla?    @relation(fields: [planillaId], references: [id], onDelete: SetNull)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([vehicleId, status])
  @@index([validTo, status])
  @@index([cryptoHash])
}

/// Snapshot persistido (Redis es caché en vivo; esto es histórico / auditoría)
model GpsSnapshot {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  speedKph  Float?
  heading   Float?
  recordedAt DateTime @default(now())

  @@index([vehicleId, recordedAt])
  @@index([recordedAt])
}

model RouteExpense {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  kind        String // PEAJE | COMBUSTIBLE | OTRO
  amount      Decimal  @db.Decimal(14, 2)
  gallons     Float?
  station     String?
  ocrPayload  Json?
  fileRef     String?
  createdAt   DateTime @default(now())

  @@index([tripId, kind])
  @@index([createdAt])
}

// =============================================================================
// 4. TALLER — OT, REPUESTOS, DESPACHO QR + EVIDENCIA CV
// =============================================================================

model WorkOrder {
  id               String          @id @default(cuid())
  code             String
  description      String
  status           WorkOrderStatus @default(OPEN)
  odometerAtOpen   Int?
  vehicleId        String
  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignedToId     String?
  assignedTo       User?           @relation("AssignedMechanic", fields: [assignedToId], references: [id], onDelete: SetNull)
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  openedAt         DateTime        @default(now())
  closedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  requiredParts WorkOrderPart[]
  dispatches    PartDispatch[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([vehicleId, status])
  @@index([assignedToId, status])
  @@index([status, openedAt])
}

model InventoryItem {
  id             String              @id @default(cuid())
  sku            String
  serial         String?
  name           String
  qrCode         String              @unique
  quantity       Int                 @default(0)
  minStock       Int                 @default(1)
  unitCost       Decimal             @db.Decimal(14, 2) @default(0)
  status         InventoryItemStatus @default(AVAILABLE)
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  workOrderParts WorkOrderPart[]
  dispatches     PartDispatch[]
  poLines        PurchaseOrderLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, serial])
  @@index([organizationId, status])
  @@index([organizationId, quantity])
  @@index([supplierId])
}

model WorkOrderPart {
  id              String        @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Int           @default(1)

  @@unique([workOrderId, inventoryItemId])
  @@index([inventoryItemId])
}

model PartDispatch {
  id                 String        @id @default(cuid())
  workOrderId        String
  workOrder          WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItemId    String
  inventoryItem      InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  dispatchedById     String
  dispatchedBy       User          @relation("PartDispatcher", fields: [dispatchedById], references: [id], onDelete: Restrict)
  mechanicQrScanned  String?
  partQrScanned      String?
  /// Evidencia CV antifraude
  photoOldRef        String?
  photoNewRef        String?
  cvValidationOk     Boolean?
  cvPayload          Json?
  dispatchedAt       DateTime      @default(now())

  @@index([workOrderId, dispatchedAt])
  @@index([inventoryItemId])
  @@index([dispatchedById, dispatchedAt])
}

// =============================================================================
// 5. COMPRAS — OC, REMISIÓN, FACTURA PROVEEDOR, 3-WAY MATCHING
// =============================================================================

model Supplier {
  id             String       @id @default(cuid())
  name           String
  nit            String
  email          String?
  phone          String?
  active         Boolean      @default(true)
  /// Bloqueo AML / listas restrictivas (Módulo 15)
  sarlaftBlocked Boolean      @default(false)
  sarlaftRiskScore Int        @default(0)
  /// SKUs / categorías que ofrece (smart bidding)
  productTags    String[]
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchaseOrders PurchaseOrder[]
  inventoryItems InventoryItem[]
  invoices       Invoice[]
  archiveDocuments ArchiveDocument[]

  @@unique([organizationId, nit])
  @@index([organizationId, active])
  @@index([organizationId, sarlaftBlocked])
}

model PurchaseOrder {
  id              String         @id @default(cuid())
  code            String
  description     String?
  status          PurchaseStatus @default(DRAFT)
  totalEstimated  Decimal        @db.Decimal(14, 2) @default(0)
  currency        String         @default("COP")
  matchStatus     ThreeWayMatchStatus @default(PENDING)
  matchNotes      String?
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  approvedById    String?
  approvedBy      User?          @relation("PurchaseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lines          PurchaseOrderLine[]
  goodsReceipts  GoodsReceipt[]
  supplierInvoices Invoice[]
  matchRecords   ThreeWayMatch[]
  archiveDocuments ArchiveDocument[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, matchStatus])
  @@index([supplierId, status])
  @@index([status, createdAt])
}

model PurchaseOrderLine {
  id              String         @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  description     String
  quantity        Int
  unitCost        Decimal        @db.Decimal(14, 2)
  lineTotal       Decimal        @db.Decimal(14, 2)

  @@index([purchaseOrderId])
  @@index([inventoryItemId])
}

/// Remisión de entrada (almacén) — pata 2 del 3-Way Matching
model GoodsReceipt {
  id              String        @id @default(cuid())
  code            String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedById    String
  receivedBy      User          @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt      DateTime      @default(now())
  quantityTotal   Int
  notes           String?
  payload         Json?

  matchRecords ThreeWayMatch[]

  @@unique([code])
  @@index([purchaseOrderId, receivedAt])
  @@index([receivedById])
}

/// Resultado del cruce OC + Remisión + Factura proveedor
model ThreeWayMatch {
  id               String              @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  goodsReceiptId   String?
  goodsReceipt     GoodsReceipt?       @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  invoiceId        String?
  invoice          Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  status           ThreeWayMatchStatus @default(PENDING)
  priceDelta       Decimal             @db.Decimal(14, 2) @default(0)
  qtyDelta         Int                 @default(0)
  details          Json?
  evaluatedAt      DateTime            @default(now())

  @@index([purchaseOrderId, status])
  @@index([status, evaluatedAt])
  @@index([invoiceId])
}

// =============================================================================
// 6. COMERCIAL — CLIENTES, COTIZACIONES, CONTRATOS
// =============================================================================

model Customer {
  id             String          @id @default(cuid())
  name           String
  nit            String
  email          String?
  phone          String?
  segment        CustomerSegment @default(B2B)
  sarlaftBlocked Boolean         @default(false)
  sarlaftRiskScore Int           @default(0)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  quotes        Quote[]
  trips         Trip[]
  invoices      Invoice[]
  sarlaftChecks SarlaftCheck[]
  contracts     TransportContract[]
  familyLinks   FamilyProfile[]
  pqrsTickets   Ticket[]
  passengers    PassengerProfile[]
  b2bRequests   B2bServiceRequest[]

  @@unique([organizationId, nit])
  @@index([organizationId, segment])
  @@index([organizationId, sarlaftBlocked])
  @@index([name])
}

model Quote {
  id         String      @id @default(cuid())
  code       String
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Decimal     @db.Decimal(14, 2)
  currency   String      @default("COP")
  status     QuoteStatus @default(DRAFT)
  notes      String?
  calcJson   Json?
  secopRef   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([code])
  @@index([customerId, status])
  @@index([status, createdAt])
}

model TransportContract {
  id                 String            @id @default(cuid())
  code               String
  name               String
  channel            CommercialChannel @default(PRIVATE)
  routeLabel         String
  monthlyValue       Decimal           @db.Decimal(14, 2)
  /// Presupuesto total contratado (COP)
  budgetCap          Decimal?          @db.Decimal(14, 2)
  budgetConsumed     Decimal           @db.Decimal(14, 2) @default(0)
  /// Cupo de viajes / vehículos
  tripQuota          Int?
  tripsUsed          Int               @default(0)
  vehicleQuota       Int?
  vehiclesAllocated  Int               @default(0)
  rateType           ContractRateType  @default(FIXED)
  fixedFare          Decimal?          @db.Decimal(14, 2)
  ratePerKm          Decimal?          @db.Decimal(14, 2)
  secopProcessId     String?
  startsAt           DateTime
  endsAt             DateTime?
  status             ContractStatus    @default(DRAFT)
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  trips Trip[]
  b2bRequests B2bServiceRequest[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([customerId, status])
  @@index([secopProcessId])
  @@index([endsAt])
}

/// Snapshot local de oportunidades SECOP II (B2G)
model SecopOpportunity {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processId        String
  title            String
  entityName       String
  modality         String
  status           String       @default("OPEN")
  category         String
  estimatedValue   Decimal?     @db.Decimal(14, 2)
  publishAt        DateTime?
  closeAt          DateTime?
  url              String?
  rawPayload       Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, processId])
  @@index([organizationId, status, closeAt])
  @@index([category, status])
}

// =============================================================================
// 7. TESORERÍA / CONTABILIDAD / REVISORÍA
// =============================================================================

model Invoice {
  id                 String        @id @default(cuid())
  number             String
  type               InvoiceType
  status             InvoiceStatus @default(DRAFT)
  counterparty       String
  amount             Decimal       @db.Decimal(14, 2)
  dueDate            DateTime?
  paidAt             DateTime?
  xmlHash            String?
  dianPayload        Json?
  paymentApproved    Boolean       @default(false)
  paymentApprovedAt  DateTime?
  paymentApprovedById String?
  paymentApprovedBy  User?         @relation("InvoicePaymentApprover", fields: [paymentApprovedById], references: [id], onDelete: SetNull)
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId         String?
  supplier           Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  tripId             String?
  trip               Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  threeWayMatches ThreeWayMatch[]
  paymentSchedules PaymentSchedule[]

  @@unique([organizationId, number])
  @@index([organizationId, type, status])
  @@index([organizationId, dueDate])
  @@index([purchaseOrderId])
  @@index([tripId])
  @@index([xmlHash])
  @@index([status, dueDate])
}

// =============================================================================
// 7b. TESORERÍA — PaymentSchedule (Zero-Touch) + Rodamientos
// =============================================================================

enum PaymentScheduleStatus {
  PENDING
  QUEUED
  DISBURSED
  FAILED
  CANCELLED
}

enum RodamientoLiquidationStatus {
  DRAFT
  LIQUIDATED
  PAID
  CANCELLED
}

/// Obligación de pago generada tras 3-Way Match APPROVED
model PaymentSchedule {
  id               String                @id @default(cuid())
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId        String
  invoice          Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  purchaseOrderId  String?
  threeWayMatchId  String?
  amount           Decimal               @db.Decimal(14, 2)
  currency         String                @default("COP")
  counterparty     String
  status           PaymentScheduleStatus @default(QUEUED)
  dueDate          DateTime?
  queuedAt         DateTime              @default(now())
  disbursedAt      DateTime?
  disbursedById    String?
  disbursedBy      User?                 @relation("PaymentDisburser", fields: [disbursedById], references: [id], onDelete: SetNull)
  mfaVerified      Boolean               @default(false)
  bankRef          String?
  failureReason    String?
  meta             Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([invoiceId])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([status, queuedAt])
  @@index([threeWayMatchId])
}

/// Liquidación periódica de rodamientos (conductores / propietarios)
model RodamientoLiquidation {
  id             String                      @id @default(cuid())
  organizationId String
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  periodFrom     DateTime
  periodTo       DateTime
  vehicleId      String?
  driverId       String?
  tripCount      Int                         @default(0)
  amount         Decimal                     @db.Decimal(14, 2)
  status         RodamientoLiquidationStatus @default(LIQUIDATED)
  details        Json?
  liquidatedById String?
  liquidatedBy   User?                       @relation("RodamientoLiquidator", fields: [liquidatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, periodFrom, periodTo])
  @@index([driverId])
  @@index([vehicleId])
}

model Account {
  id             String       @id @default(cuid())
  code           String
  name           String
  type           AccountType
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  debitLines  JournalLine[] @relation("DebitAccount")
  creditLines JournalLine[] @relation("CreditAccount")

  @@unique([organizationId, code])
  @@index([organizationId, type])
}

model JournalEntry {
  id             String             @id @default(cuid())
  memo           String
  status         JournalEntryStatus @default(DRAFT)
  postedAt       DateTime?
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lines JournalLine[]

  @@index([organizationId, status])
  @@index([organizationId, postedAt])
}

model JournalLine {
  id             String       @id @default(cuid())
  entryId        String
  entry          JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  debitAccountId String
  debitAccount   Account      @relation("DebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccountId String
  creditAccount  Account      @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)
  amount         Decimal      @db.Decimal(14, 2)

  @@index([entryId])
  @@index([debitAccountId])
  @@index([creditAccountId])
}

model ForensicFinding {
  id             String       @id @default(cuid())
  title          String
  severity       String
  detail         String
  amount         Decimal?     @db.Decimal(14, 2)
  status         String       @default("OPEN")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, severity])
}

// =============================================================================
// 8. RRHH · RECEPCIÓN/CALL · HQSE · SARLAFT · ARCHIVO · PARQUEADERO · TI
// =============================================================================

model Employee {
  id             String         @id @default(cuid())
  name           String
  document       String
  title          String
  area           String
  status         EmployeeStatus @default(ACTIVE)
  fatigueScore   Int            @default(0)
  sarlaftBlocked Boolean        @default(false)
  sarlaftRiskScore Int          @default(0)
  /// Salario base periódico (COP)
  baseSalary     Decimal        @db.Decimal(14, 2) @default(0)
  /// Tarifa hora ordinaria (COP) — overtime / nocturno
  hourlyRate     Decimal        @db.Decimal(14, 2) @default(0)
  email          String?
  phone          String?
  /// Vínculo opcional a perfil conductor (fatiga / comisiones)
  driverId       String?        @unique
  driver         Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  payrollLines PayrollLine[]

  @@unique([organizationId, document])
  @@index([organizationId, status])
  @@index([organizationId, area])
  @@index([organizationId, sarlaftBlocked])
  @@index([fatigueScore])
}

/// Turno laboral conductor — telemetría de fatiga (check-in / check-out)
model DriverShift {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  driverId         String
  driver           Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  checkInAt        DateTime
  checkOutAt       DateTime?
  status           ShiftStatus  @default(OPEN)
  continuousHours  Float?
  notes            String?
  meta             Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, driverId, checkInAt])
  @@index([driverId, status])
  @@index([organizationId, status])
}

model PayrollRun {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodStart      DateTime
  periodEnd        DateTime
  status           PayrollRunStatus @default(DRAFT)
  totalGross       Decimal          @db.Decimal(14, 2) @default(0)
  totalOvertime    Decimal          @db.Decimal(14, 2) @default(0)
  totalNight       Decimal          @db.Decimal(14, 2) @default(0)
  totalCommissions Decimal          @db.Decimal(14, 2) @default(0)
  totalNet         Decimal          @db.Decimal(14, 2) @default(0)
  calculatedAt     DateTime?
  meta             Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lines PayrollLine[]

  @@index([organizationId, periodStart, periodEnd])
  @@index([organizationId, status])
}

model PayrollLine {
  id              String     @id @default(cuid())
  payrollRunId    String
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  driverId        String?
  driver          Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  baseSalary      Decimal    @db.Decimal(14, 2) @default(0)
  ordinaryHours   Float      @default(0)
  overtimeHours   Float      @default(0)
  overtimeAmount  Decimal    @db.Decimal(14, 2) @default(0)
  nightHours      Float      @default(0)
  nightAmount     Decimal    @db.Decimal(14, 2) @default(0)
  completedTrips  Int        @default(0)
  tripCommissions Decimal    @db.Decimal(14, 2) @default(0)
  grossTotal      Decimal    @db.Decimal(14, 2) @default(0)
  meta            Json?
  createdAt       DateTime   @default(now())

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([driverId])
}

model Ticket {
  id               String          @id @default(cuid())
  code             String
  subject          String
  requester        String
  channel          TicketChannel   @default(PHONE)
  message          String
  status           TicketStatus    @default(OPEN)
  priority         TicketPriority  @default(MEDIUM)
  /// Clasificación PQRS (null = ticket helpdesk genérico)
  pqrsType         PqrsType?
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicleId        String?
  vehicle          Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId         String?
  driver           Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  /// SLA automático (horas / vencimiento)
  slaHours         Int?
  slaDueAt         DateTime?
  slaBreached      Boolean         @default(false)
  resolvedAt       DateTime?
  resolutionNotes  String?
  /// Escalamiento trazabilidad hoja de vida
  escalatedToRrhh  Boolean         @default(false)
  escalatedToHqse  Boolean         @default(false)
  assigneeId       String?
  assignee         User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meta             Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, priority, status])
  @@index([organizationId, pqrsType, status])
  @@index([customerId, status])
  @@index([assigneeId, status])
  @@index([channel, status])
  @@index([slaDueAt, status])
  @@index([driverId])
  @@index([vehicleId])
  @@index([createdAt])
}

model Visitor {
  id             String       @id @default(cuid())
  name           String
  document       String
  company        String?
  reason         String
  hostName       String
  kind           VisitorKind  @default(VISITOR)
  siteLabel      String?
  phone          String?
  /// ARL vigente requerida para contratistas
  arlValid       Boolean      @default(false)
  arlExpiresAt   DateTime?
  passCode       String?
  qrPayload      String?
  badgeIssuedAt  DateTime?
  checkedInAt    DateTime     @default(now())
  checkedOutAt   DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meta           Json?

  @@index([organizationId, checkedOutAt])
  @@index([organizationId, passCode])
  @@index([document])
  @@index([kind, checkedOutAt])
}

model QualityEvent {
  id             String       @id @default(cuid())
  kind           String
  title          String
  status         String       @default("OPEN")
  npsScore       Int?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([kind, createdAt])
}

/// Incidente / accidente de tránsito o hallazgo SST (Módulo 14 HQSE)
model HqseIncident {
  id             String           @id @default(cuid())
  code           String
  kind           IncidentKind     @default(TRAFFIC_ACCIDENT)
  severity       IncidentSeverity
  status         IncidentStatus   @default(OPEN)
  title          String
  description    String?
  occurredAt     DateTime
  location       String?
  vehicleId      String?
  vehicle        Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId       String?
  driver         Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  /// OT de peritaje abierta en Taller (07)
  workOrderId    String?
  autoBlocked    Boolean          @default(false)
  reportedById   String?
  meta           Json?
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, severity, status])
  @@index([organizationId, occurredAt])
  @@index([vehicleId, severity])
  @@index([driverId, severity])
}

/// Matriz de riesgos PESV / ISO 39001
model PesvRiskControl {
  id               String            @id @default(cuid())
  code             String
  category         String
  title            String
  description      String?
  status           PesvControlStatus @default(PENDING)
  residualRisk     Int               @default(3)
  lastReviewedAt   DateTime?
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([category, status])
}

/// Capacitación conductor (PESV / defensiva / SST)
model HqseTrainingRecord {
  id               String       @id @default(cuid())
  driverId         String
  driver           Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  topic            String
  completedAt      DateTime
  expiresAt        DateTime?
  provider         String?
  certificateRef   String?
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, topic, completedAt])
  @@index([driverId, expiresAt])
}

/// Simulacro de seguridad vial / emergencia
model HqseSafetyDrill {
  id             String       @id @default(cuid())
  code           String
  title          String
  scheduledAt    DateTime
  completedAt    DateTime?
  participants   Int          @default(0)
  result         String?
  notes          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, scheduledAt])
  @@index([completedAt])
}

/// Auditoría interna/externa ISO / PESV
model HqseAudit {
  id               String          @id @default(cuid())
  code             String
  scope            HqseAuditScope  @default(INTERNAL)
  standard         String          @default("ISO_39001")
  title            String
  status           HqseAuditStatus @default(PLANNED)
  auditedAt        DateTime
  findingsCount    Int             @default(0)
  nonConformities  Int             @default(0)
  score            Int?
  auditorName      String?
  notes            String?
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status, auditedAt])
  @@index([standard, scope])
}

model SarlaftCheck {
  id               String             @id @default(cuid())
  subjectName      String
  document         String
  risk             SarlaftRisk        @default(LOW)
  /// Score 0–100 (umbral bloqueo >= 80)
  riskScore        Int                @default(0)
  entityType       SarlaftEntityType?
  entityId         String?
  /// Listas con hit: OFAC | ONU | PEPS | NACIONAL
  listsMatched     String[]
  status           SarlaftAlertStatus @default(PENDING)
  notes            String?
  graphPayload     Json?
  customerId       String?
  customer         Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedBy       User?              @relation("SarlaftResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNotes  String?
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([organizationId, risk])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([document])
  @@index([customerId])
  @@index([riskScore])
}

model ArchiveDocument {
  id               String                  @id @default(cuid())
  title            String
  category         ArchiveCategory         @default(OTHER)
  docType          ArchiveDocType          @default(OTHER)
  validationStatus ArchiveValidationStatus @default(PENDING)
  tags             String[]
  contentHash      String?
  fileRef          String?
  originalName     String?
  mimeType         String?
  byteSize         Int?
  /// Vínculo polimórfico Data Room
  entityType       ArchiveEntityType?
  entityId         String?
  vehicleId        String?
  vehicle          Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId         String?
  driver           Driver?                 @relation(fields: [driverId], references: [id], onDelete: SetNull)
  supplierId       String?
  supplier         Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrderId  String?
  purchaseOrder    PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  /// Metadatos OCR estructurados
  plate            String?
  taxIdOrDocument  String?
  issuer           String?
  amount           Decimal?                @db.Decimal(14, 2)
  issuedAt         DateTime?
  expiresAt        DateTime?
  ocrPayload       Json?
  ocrProcessedAt   DateTime?
  uploadedById     String?
  uploadedBy       User?                   @relation("ArchiveUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  deletedAt        DateTime?
  organizationId   String
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([organizationId, category])
  @@index([organizationId, docType])
  @@index([organizationId, validationStatus])
  @@index([organizationId, entityType, entityId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([contentHash])
  @@index([title])
  @@index([plate])
  @@index([deletedAt])
}

enum YardAccessKind {
  CHECK_IN
  CHECK_OUT
}

enum YardInspectionPhase {
  CHECK_IN
  CHECK_OUT
  SPOT_CHECK
}

model ParkingLog {
  id             String       @id @default(cuid())
  plate          String
  driverName     String?
  guardName      String?
  checkedInAt    DateTime     @default(now())
  checkedOutAt   DateTime?
  odometerInKm   Int?
  odometerOutKm  Int?
  driverId       String?
  driver         Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  accessLogs   YardAccessLog[]
  inspections  YardInspection[]

  @@index([organizationId, checkedOutAt])
  @@index([plate, checkedInAt])
  @@index([vehicleId])
  @@index([driverId])
}

/// Evento de talanquera / LPR (Smart Gate)
model YardAccessLog {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind            YardAccessKind
  plate           String
  vehicleId       String?
  vehicle         Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId        String?
  driver          Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  parkingLogId    String?
  parkingLog      ParkingLog?    @relation(fields: [parkingLogId], references: [id], onDelete: SetNull)
  odometerKm      Int?
  gateId          String?
  cameraRef       String?
  lprConfidence   Float?
  gateOpened      Boolean        @default(false)
  denied          Boolean        @default(false)
  denyReason      String?
  meta            Json?
  createdAt       DateTime       @default(now())

  @@index([organizationId, kind, createdAt])
  @@index([vehicleId, createdAt])
  @@index([plate, createdAt])
  @@index([parkingLogId])
}

/// Acta de inspección física de patio (CV / inventario)
model YardInspection {
  id                   String              @id @default(cuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicleId            String
  vehicle              Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  parkingLogId         String?
  parkingLog           ParkingLog?         @relation(fields: [parkingLogId], references: [id], onDelete: SetNull)
  phase                YardInspectionPhase @default(CHECK_IN)
  fuelLevelPct         Int?
  tireCondition        String?
  visualDamageNotes    String?
  criticalSafetyFault  Boolean             @default(false)
  criticalFaultDetail  String?
  photoRefs            String[]
  inspectorName        String?
  workOrderId          String?
  meta                 Json?
  createdAt            DateTime            @default(now())

  @@index([organizationId, createdAt])
  @@index([vehicleId, createdAt])
  @@index([criticalSafetyFault, createdAt])
  @@index([parkingLogId])
}

model YardEvent {
  id             String       @id @default(cuid())
  kind           String // ENTRY | EXIT | DAMAGE_CV | GATE_DENY
  payload        Json?
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, kind, createdAt])
  @@index([vehicleId, createdAt])
}

model SystemAlert {
  id             String       @id @default(cuid())
  severity       String
  source         String
  message        String
  resolved       Boolean      @default(false)
  resolvedAt     DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, resolved, createdAt])
  @@index([severity, resolved])
}

/// Log centralizado NOC / Event Mesh (Módulo 17)
model SystemLog {
  id             String         @id @default(cuid())
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  level          SystemLogLevel @default(INFO)
  source         String
  message        String
  correlationId  String?
  meta           Json?
  createdAt      DateTime       @default(now())

  @@index([organizationId, createdAt])
  @@index([level, createdAt])
  @@index([source, createdAt])
  @@index([correlationId])
}

/// Mensaje en Dead-Letter Queue Kafka
model KafkaDlqMessage {
  id             String          @id @default(cuid())
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  topic          String
  originalTopic  String?
  partition      Int             @default(0)
  offset         String?
  payload        Json
  errorMessage   String
  attempts       Int             @default(0)
  status         DlqMessageStatus @default(PENDING)
  lastErrorAt    DateTime        @default(now())
  replayedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, lastErrorAt])
  @@index([topic, status])
  @@index([organizationId, status])
}

/// Job Speech-to-Text / Text-to-Speech (Gemini STTS mock)
model SttsJob {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mode           SttsMode
  status         SttsJobStatus @default(PENDING)
  provider       String        @default("GEMINI_STTS_MOCK")
  inputRef       String?
  inputText      String?
  outputText     String?
  audioRef       String?
  mimeType       String?
  durationMs     Int?
  confidence     Float?
  meta           Json?
  errorMessage   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, mode, createdAt])
  @@index([status, createdAt])
}

model SystemTicket {
  id        String   @id @default(cuid())
  title     String
  detail    String?
  status    String   @default("OPEN")
  createdById String?
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// =============================================================================
// 9. APPS MÓVILES — MONITORA · PADRES · PASAJEROS (núcleo)
// =============================================================================

model MonitorProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  boardingEvents BoardingEvent[]
  schoolRoutes   SchoolRoute[]
  schoolRuns     SchoolRouteRun[]
}

model FamilyProfile {
  id             String       @id @default(cuid())
  name           String
  phone          String?
  pushToken      String?
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  dependents    Dependent[]
  notifications ParentNotification[]

  @@index([organizationId])
  @@index([customerId])
}

model Dependent {
  id             String            @id @default(cuid())
  name           String
  document       String?
  familyId       String
  family         FamilyProfile     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  boardingEvents BoardingEvent[]
  schoolStudent  SchoolStudent?

  @@index([familyId])
}

/// Estudiante escolar (QR/NFC) — vínculo opcional a Dependent/familia
model SchoolStudent {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  document       String?
  qrCode         String
  nfcUid         String?
  schoolName     String?
  grade          String?
  currentStatus  StudentTripStatus @default(PENDING)
  dependentId    String?           @unique
  dependent      Dependent?        @relation(fields: [dependentId], references: [id], onDelete: SetNull)
  familyId       String?
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  assignments    SchoolStudentAssignment[]
  boardingEvents SchoolBoardingEvent[]
  novelties      SchoolNovelty[]
  notifications  ParentNotification[]

  @@unique([organizationId, qrCode])
  @@index([organizationId, currentStatus])
  @@index([nfcUid])
  @@index([familyId])
}

model SchoolRoute {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  direction      SchoolRouteDirection @default(TO_SCHOOL)
  active         Boolean              @default(true)
  vehicleId      String?
  vehicle        Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId       String?
  driver         Driver?              @relation(fields: [driverId], references: [id], onDelete: SetNull)
  monitorId      String?
  monitor        MonitorProfile?      @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  /// Última posición reportada del bus
  lastLat        Float?
  lastLng        Float?
  lastLocatedAt  DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  stops       SchoolStop[]
  assignments SchoolStudentAssignment[]
  runs        SchoolRouteRun[]
  boardingEvents SchoolBoardingEvent[]
  novelties   SchoolNovelty[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([vehicleId])
  @@index([monitorId])
}

model SchoolStop {
  id           String         @id @default(cuid())
  schoolRouteId String
  schoolRoute  SchoolRoute    @relation(fields: [schoolRouteId], references: [id], onDelete: Cascade)
  sequence     Int
  name         String
  address      String?
  kind         SchoolStopKind @default(PICKUP)
  lat          Float?
  lng          Float?

  assignments SchoolStudentAssignment[]

  @@index([schoolRouteId, sequence])
}

model SchoolStudentAssignment {
  id            String        @id @default(cuid())
  schoolRouteId String
  schoolRoute   SchoolRoute   @relation(fields: [schoolRouteId], references: [id], onDelete: Cascade)
  studentId     String
  student       SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stopId        String?
  stop          SchoolStop?   @relation(fields: [stopId], references: [id], onDelete: SetNull)
  active        Boolean       @default(true)

  @@unique([schoolRouteId, studentId])
  @@index([studentId, active])
}

model SchoolRouteRun {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolRouteId  String
  schoolRoute    SchoolRoute          @relation(fields: [schoolRouteId], references: [id], onDelete: Cascade)
  status         SchoolRouteRunStatus @default(PLANNED)
  monitorId      String?
  monitor        MonitorProfile?      @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  startedAt      DateTime?
  endedAt        DateTime?
  startLat       Float?
  startLng       Float?
  endLat         Float?
  endLng         Float?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  boardingEvents SchoolBoardingEvent[]
  novelties      SchoolNovelty[]

  @@index([organizationId, status])
  @@index([schoolRouteId, status])
  @@index([startedAt])
}

model SchoolBoardingEvent {
  id             String               @id @default(cuid())
  organizationId String
  studentId      String
  student        SchoolStudent        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolRouteId  String
  schoolRoute    SchoolRoute          @relation(fields: [schoolRouteId], references: [id], onDelete: Cascade)
  runId          String?
  run            SchoolRouteRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  kind           SchoolBoardingKind
  method         SchoolBoardingMethod @default(QR)
  resultingStatus StudentTripStatus
  lat            Float?
  lng            Float?
  monitorUserId  String?
  createdAt      DateTime             @default(now())

  @@index([studentId, createdAt])
  @@index([schoolRouteId, createdAt])
  @@index([runId, createdAt])
  @@index([organizationId, createdAt])
}

model SchoolNovelty {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           SchoolNoveltyKind
  notes          String?
  schoolRouteId  String?
  schoolRoute    SchoolRoute?      @relation(fields: [schoolRouteId], references: [id], onDelete: SetNull)
  runId          String?
  run            SchoolRouteRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  studentId      String?
  student        SchoolStudent?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  reportedById   String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, createdAt])
  @@index([schoolRouteId, createdAt])
  @@index([studentId])
}

model ParentNotification {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  familyId       String?
  family         FamilyProfile? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  studentId      String?
  student        SchoolStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  title          String
  body           String
  channel        String        @default("PUSH")
  read           Boolean       @default(false)
  payload        Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([familyId, read])
  @@index([studentId, createdAt])
}

model BoardingEvent {
  id          String          @id @default(cuid())
  dependentId String
  dependent   Dependent       @relation(fields: [dependentId], references: [id], onDelete: Cascade)
  monitorId   String?
  monitor     MonitorProfile? @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  kind        String // BOARD | ALIGHT | ABSENT
  lat         Float?
  lng         Float?
  createdAt   DateTime        @default(now())

  @@index([dependentId, createdAt])
  @@index([monitorId, createdAt])
}

model PassengerProfile {
  id             String       @id @default(cuid())
  name           String
  phone          String?
  email          String?
  document       String?
  externalRef    String?
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  rideRequests   RideRequest[]
  boardingPasses BoardingPass[]

  @@index([organizationId])
  @@index([externalRef])
  @@index([customerId])
  @@index([document])
}

model RideRequest {
  id          String           @id @default(cuid())
  passengerId String
  passenger   PassengerProfile @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  origin      String
  destination String
  status      String           @default("REQUESTED")
  rating      Int?
  npsComment  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([passengerId, status])
  @@index([status, createdAt])
}

/// Boarding Pass dinámico corporativo (QR + token temporal) — Módulo 20
model BoardingPass {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  passengerId    String
  passenger      PassengerProfile   @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  tripId         String
  trip           Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  token          String             @unique
  qrPayload      String
  status         BoardingPassStatus @default(ISSUED)
  expiresAt      DateTime
  validatedAt    DateTime?
  validatedById  String?
  seatLabel      String?
  meta           Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([tripId, status])
  @@index([passengerId, createdAt])
  @@index([expiresAt])
}

/// Solicitud de servicio expreso / reprogramación — Portal B2B (Módulo 21)
model B2bServiceRequest {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contractId     String
  contract       TransportContract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind           B2bServiceRequestKind   @default(EXPRESS)
  status         B2bServiceRequestStatus @default(PENDING)
  origin         String
  destination    String
  requestedAt    DateTime                @default(now())
  departAt       DateTime?
  estimatedFare  Decimal?                @db.Decimal(14, 2)
  notes          String?
  rejectionReason String?
  tripId         String?
  trip           Trip?                   @relation(fields: [tripId], references: [id], onDelete: SetNull)
  originalTripId String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([customerId, status])
  @@index([contractId, status])
  @@index([tripId])
}
