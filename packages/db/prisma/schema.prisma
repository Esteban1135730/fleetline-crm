/// Inventario administrativo — papelería / dotación (Módulo 3)
model StationeryItem {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku            String
  name           String
  unit           String   @default("UND")
  quantity       Int      @default(0)
  /// Umbral de reorden (alerta Kafka si quantity <= minStock)
  minStock       Int      @default(5)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  dispatches     StationeryDispatch[]

  @@unique([organizationId, sku])
  @@index([organizationId, quantity])
  @@index([organizationId, minStock])
}

model StationeryDispatch {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           StationeryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity       Int
  ticketRef      String?
  notes          String?
  requestedById  String?
  dispatchedById String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([itemId, createdAt])
}

/// Préstamo de carpeta / documento físico
model DocumentLoan {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String
  document       ArchiveDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  borrowerUserId String
  borrowerName   String?
  purpose        String?
  status         String   @default("ON_LOAN") // ON_LOAN | RETURNED | OVERDUE
  checkedOutAt   DateTime @default(now())
  dueAt          DateTime?
  returnedAt     DateTime?
  reminderSentAt DateTime?
  checkedOutById String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status, checkedOutAt])
  @@index([documentId, status])
  @@index([borrowerUserId])
}

enum YardAccessKind {
  CHECK_IN
  CHECK_OUT
}

enum YardInspectionPhase {
  CHECK_IN
  CHECK_OUT
  SPOT_CHECK
}

model ParkingLog {
  id             String       @id @default(cuid())
  plate          String
  driverName     String?
  guardName      String?
  checkedInAt    DateTime     @default(now())
  checkedOutAt   DateTime?
  odometerInKm   Int?
  odometerOutKm  Int?
  driverId       String?
  driver         Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  accessLogs   YardAccessLog[]
  inspections  YardInspection[]

  @@index([organizationId, checkedOutAt])
  @@index([plate, checkedInAt])
  @@index([vehicleId])
  @@index([driverId])
}

/// Evento de talanquera / LPR (Smart Gate)
model YardAccessLog {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind            YardAccessKind
  plate           String
  vehicleId       String?
  vehicle         Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId        String?
  driver          Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  parkingLogId    String?
  parkingLog      ParkingLog?    @relation(fields: [parkingLogId], references: [id], onDelete: SetNull)
  odometerKm      Int?
  gateId          String?
  cameraRef       String?
  lprConfidence   Float?
  gateOpened      Boolean        @default(false)
  denied          Boolean        @default(false)
  denyReason      String?
  meta            Json?
  createdAt       DateTime       @default(now())

  @@index([organizationId, kind, createdAt])
  @@index([vehicleId, createdAt])
  @@index([plate, createdAt])
  @@index([parkingLogId])
}

/// Acta de inspección física de patio (CV / inventario)
model YardInspection {
  id                   String              @id @default(cuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicleId            String
  vehicle              Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  parkingLogId         String?
  parkingLog           ParkingLog?         @relation(fields: [parkingLogId], references: [id], onDelete: SetNull)
  phase                YardInspectionPhase @default(CHECK_IN)
  fuelLevelPct         Int?
  tireCondition        String?
  visualDamageNotes    String?
  criticalSafetyFault  Boolean             @default(false)
  criticalFaultDetail  String?
  photoRefs            String[]
  inspectorName        String?
  workOrderId          String?
  meta                 Json?
  createdAt            DateTime            @default(now())

  @@index([organizationId, createdAt])
  @@index([vehicleId, createdAt])
  @@index([criticalSafetyFault, createdAt])
  @@index([parkingLogId])
}

model YardEvent {
  id             String       @id @default(cuid())
  kind           String // ENTRY | EXIT | DAMAGE_CV | GATE_DENY
  payload        Json?
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, kind, createdAt])
  @@index([vehicleId, createdAt])
}

model SystemAlert {
  id             String       @id @default(cuid())
  severity       String
  source         String
  message        String
  resolved       Boolean      @default(false)
  resolvedAt     DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, resolved, createdAt])
  @@index([severity, resolved])
}

/// Inbox unificado (campana web + in-app móvil)
model UserNotification {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           NotificationKind    @default(SYSTEM)
  title          String
  body           String
  href           String?
  payload        Json?
  channels       NotificationChannel[]
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([organizationId, createdAt])
  @@index([kind, createdAt])
}

/// Suscripción Web Push (VAPID / Push API del navegador)
model WebPushSubscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, endpoint])
  @@index([organizationId, userId])
}

/// Token push remoto (Expo / FCM / APNs)
model DevicePushToken {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       DevicePlatform
  token          String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, token])
  @@index([organizationId, platform])
}

/// Log centralizado NOC / Event Mesh (Módulo 17)
model SystemLog {
  id             String         @id @default(cuid())
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  level          SystemLogLevel @default(INFO)
  source         String
  message        String
  correlationId  String?
  meta           Json?
  createdAt      DateTime       @default(now())

  @@index([organizationId, createdAt])
  @@index([level, createdAt])
  @@index([source, createdAt])
  @@index([correlationId])
}

/// Mensaje en Dead-Letter Queue Kafka
model KafkaDlqMessage {
  id             String          @id @default(cuid())
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  topic          String
  originalTopic  String?
  partition      Int             @default(0)
  offset         String?
  payload        Json
  errorMessage   String
  attempts       Int             @default(0)
  status         DlqMessageStatus @default(PENDING)
  lastErrorAt    DateTime        @default(now())
  replayedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, lastErrorAt])
  @@index([topic, status])
  @@index([organizationId, status])
}

/// Job Speech-to-Text / Text-to-Speech (Gemini STTS mock)
model SttsJob {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mode           SttsMode
  status         SttsJobStatus @default(PENDING)
  provider       String        @default("GEMINI_STTS_MOCK")
  inputRef       String?
  inputText      String?
  outputText     String?
  audioRef       String?
  mimeType       String?
  durationMs     Int?
  confidence     Float?
  meta           Json?
  errorMessage   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, mode, createdAt])
  @@index([status, createdAt])
}

model SystemTicket {
  id             String        @id @default(cuid())
  title          String
  detail         String?
  status         String        @default("OPEN")
  /// HIGH | MEDIUM | LOW
  priority       String        @default("MEDIUM")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([organizationId, priority, status])
}

/// Link de un solo uso — onboarding / reset seguro (Módulo 2 TI)
model TiOnboardingLink {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  targetRole     RoleCode  @default(CONDUCTOR)
  tokenHash      String
  expiresAt      DateTime
  usedAt         DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@index([organizationId, email])
  @@index([tokenHash])
  @@index([expiresAt])
}

/// Emparejamiento MDM móvil — QR temporal (FSG Pilot App)
model TiMdmPairSession {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pairCode       String
  driverUserId   String?
  deviceId       String?
  locked         Boolean   @default(true)
  expiresAt      DateTime
  pairedAt       DateTime?
  createdById    String?
  meta           Json?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, pairCode])
  @@index([organizationId, expiresAt])
  @@index([driverUserId])
}

// =============================================================================
// 9. APPS MÓVILES — MONITORA · PADRES · PASAJEROS (núcleo)
// =============================================================================

model MonitorProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  boardingEvents BoardingEvent[]
  schoolRoutes   SchoolRoute[]
  schoolRuns     SchoolRouteRun[]
}

model FamilyProfile {
  id             String       @id @default(cuid())
  name           String
  phone          String?
  pushToken      String?
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  dependents    Dependent[]
  notifications ParentNotification[]

  @@index([organizationId])
  @@index([customerId])
}

model Dependent {
  id             String            @id @default(cuid())
  name           String
  document       String?
  familyId       String
  family         FamilyProfile     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  boardingEvents BoardingEvent[]
  schoolStudent  SchoolStudent?

  @@index([familyId])
}

/// Estudiante escolar (QR/NFC) — vínculo opcional a Dependent/familia
model SchoolStudent {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  document       String?
  qrCode         String
  nfcUid         String?
  schoolName     String?
  grade          String?
  currentStatus  StudentTripStatus @default(PENDING)
  dependentId    String?           @unique
  dependent      Dependent?        @relation(fields: [dependentId], references: [id], onDelete: SetNull)
  familyId       String?
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  assignments    SchoolStudentAssignment[]
  boardingEvents SchoolBoardingEvent[]
  novelties      SchoolNovelty[]
  notifications  ParentNotification[]

  @@unique([organizationId, qrCode])
  @@index([organizationId, currentStatus])
  @@index([nfcUid])
  @@index([familyId])
}

model SchoolRoute {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  direction      SchoolRouteDirection @default(TO_SCHOOL)
  active         Boolean              @default(true)
  vehicleId      String?
  vehicle        Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId       String?
  driver         Driver?              @relation(fields: [driverId], references: [id], onDelete: SetNull)
  monitorId      String?
  monitor        MonitorProfile?      @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  /// Última posición reportada del bus
  lastLat        Float?
  lastLng        Float?
  lastLocatedAt  DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  stops       SchoolStop[]
  assignments SchoolStudentAssignment[]
  runs        SchoolRouteRun[]
  boardingEvents SchoolBoardingEvent[]
  novelties   SchoolNovelty[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([vehicleId])
  @@index([monitorId])
}

model SchoolStop {
  id           String         @id @default(cuid())
  schoolRouteId String
  schoolRoute  SchoolRoute    @relation(fields: [schoolRouteId], references: [id], onDelete: Cascade)
  sequence     Int
  name         String
  address      String?
  kind         SchoolStopKind @default(PICKUP)
  lat          Float?
  lng          Float?

  assignments SchoolStudentAssignment[]

  @@index([schoolRouteId, sequence])
}

model SchoolStudentAssignment {
  id            String        @id @default(cuid())
  schoolRouteId String
  schoolRoute   SchoolRoute   @relation(fields: [schoolRouteId], references: [id], onDelete: Cascade)
  studentId     String
  student       SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stopId        String?
  stop          SchoolStop?   @relation(fields: [stopId], references: [id], onDelete: SetNull)
  active        Boolean       @default(true)

  @@unique([schoolRouteId, studentId])
  @@index([studentId, active])
}

model SchoolRouteRun {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolRouteId  String
  schoolRoute    SchoolRoute          @relation(fields: [schoolRouteId], references: [id], onDelete: Cascade)
  status         SchoolRouteRunStatus @default(PLANNED)
  monitorId      String?
  monitor        MonitorProfile?      @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  startedAt      DateTime?
  endedAt        DateTime?
  startLat       Float?
  startLng       Float?
  endLat         Float?
  endLng         Float?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  boardingEvents SchoolBoardingEvent[]
  novelties      SchoolNovelty[]

  @@index([organizationId, status])
  @@index([schoolRouteId, status])
  @@index([startedAt])
}

model SchoolBoardingEvent {
  id             String               @id @default(cuid())
  organizationId String
  studentId      String
  student        SchoolStudent        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolRouteId  String
  schoolRoute    SchoolRoute          @relation(fields: [schoolRouteId], references: [id], onDelete: Cascade)
  runId          String?
  run            SchoolRouteRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  kind           SchoolBoardingKind
  method         SchoolBoardingMethod @default(QR)
  resultingStatus StudentTripStatus
  lat            Float?
  lng            Float?
  monitorUserId  String?
  createdAt      DateTime             @default(now())

  @@index([studentId, createdAt])
  @@index([schoolRouteId, createdAt])
  @@index([runId, createdAt])
  @@index([organizationId, createdAt])
}

model SchoolNovelty {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           SchoolNoveltyKind
  notes          String?
  schoolRouteId  String?
  schoolRoute    SchoolRoute?      @relation(fields: [schoolRouteId], references: [id], onDelete: SetNull)
  runId          String?
  run            SchoolRouteRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  studentId      String?
  student        SchoolStudent?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  reportedById   String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, createdAt])
  @@index([schoolRouteId, createdAt])
  @@index([studentId])
}

model ParentNotification {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  familyId       String?
  family         FamilyProfile? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  studentId      String?
  student        SchoolStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  title          String
  body           String
  channel        String        @default("PUSH")
  read           Boolean       @default(false)
  payload        Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([familyId, read])
  @@index([studentId, createdAt])
}

model BoardingEvent {
  id          String          @id @default(cuid())
  dependentId String
  dependent   Dependent       @relation(fields: [dependentId], references: [id], onDelete: Cascade)
  monitorId   String?
  monitor     MonitorProfile? @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  kind        String // BOARD | ALIGHT | ABSENT
  lat         Float?
  lng         Float?
  createdAt   DateTime        @default(now())

  @@index([dependentId, createdAt])
  @@index([monitorId, createdAt])
}

model PassengerProfile {
  id             String       @id @default(cuid())
  name           String
  phone          String?
  email          String?
  document       String?
  externalRef    String?
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  rideRequests   RideRequest[]
  boardingPasses BoardingPass[]

  @@index([organizationId])
  @@index([externalRef])
  @@index([customerId])
  @@index([document])
}

model RideRequest {
  id          String           @id @default(cuid())
  passengerId String
  passenger   PassengerProfile @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  origin      String
  destination String
  status      String           @default("REQUESTED")
  rating      Int?
  npsComment  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([passengerId, status])
  @@index([status, createdAt])
}

/// Boarding Pass dinámico corporativo (QR + token temporal) — Módulo 20
model BoardingPass {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  passengerId    String
  passenger      PassengerProfile   @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  tripId         String
  trip           Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  token          String             @unique
  qrPayload      String
  status         BoardingPassStatus @default(ISSUED)
  expiresAt      DateTime
  validatedAt    DateTime?
  validatedById  String?
  seatLabel      String?
  meta           Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([tripId, status])
  @@index([passengerId, createdAt])
  @@index([expiresAt])
}

/// Solicitud de servicio expreso / reprogramación — Portal B2B (Módulo 21)
model B2bServiceRequest {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contractId     String
  contract       TransportContract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind           B2bServiceRequestKind   @default(EXPRESS)
  status         B2bServiceRequestStatus @default(PENDING)
  origin         String
  destination    String
  requestedAt    DateTime                @default(now())
  departAt       DateTime?
  estimatedFare  Decimal?                @db.Decimal(14, 2)
  notes          String?
  rejectionReason String?
  tripId         String?
  trip           Trip?                   @relation(fields: [tripId], references: [id], onDelete: SetNull)
  originalTripId String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([customerId, status])
  @@index([contractId, status])
  @@index([tripId])
}
