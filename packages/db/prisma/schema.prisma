  previousAccount  String?
  newAccount       String
  previousBank     String?
  newBank          String?
  changedById      String?
  ipAddress        String?
  hardBlockId      String?
  createdAt        DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([supplierId, createdAt])
}

/// Snapshot Smart Audit combustible (galones vs GPS vs rendimiento)
model ForensicFuelAudit {
  id               String       @id @default(cuid())
  organizationId   String
