{
  "name": "crmtrasporte",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @fsg/db generate",
    "db:migrate": "pnpm --filter @fsg/db migrate",
    "db:seed": "pnpm --filter @fsg/db db:seed",
    "db:studio": "pnpm --filter @fsg/db studio",
    "docker:up": "docker compose -p fleetline up -d",
    "docker:down": "docker compose -p fleetline down",
    "docker:prod:up": "docker compose -p fleetline -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "docker:prod:down": "docker compose -p fleetline -f docker-compose.prod.yml --env-file .env.production down",
    "docker:prod:logs": "docker compose -p fleetline -f docker-compose.prod.yml logs -f",
    "test:visual": "playwright test --headed --reporter=html",
    "test:visual:headless": "playwright test --reporter=html",
    "test:visual:report": "playwright show-report",
    "test:e2e:full": "playwright test e2e/full-lifecycle.spec.ts --reporter=html",
    "audit:deps": "pnpm audit --audit-level=high",
    "audit:deps:json": "pnpm audit --audit-level=high --json"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.1.8",
      "@types/react-dom": "^19.1.6"
    }
  }
}
